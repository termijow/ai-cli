# Configuración de AI-CLI

# URL del servidor llama.cpp (o compatible con OpenAI completion API)
AI_API_URL=http://localhost:8080/completion

# Nivel de detalle de los logs (DEBUG, INFO, WARN, ERROR)
AI_LOG_LEVEL=INFO

# Directorio para copias de seguridad automáticas
AI_BACKUP_DIR=.ai_backups

# Modelo o parámetros adicionales (opcional para futuras expansiones)
# AI_MODEL=llama-3-8b
