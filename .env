# --- MODELO ACTIVO ---
# Cambia entre perfiles con: ai models
MODEL_REPO=unsloth/Qwen3.5-0.8B-GGUF
MODEL_FILE=Ling-3.0-tiny-Q4_K_M.gguf
PORT=1234

LLAMA_PATH=/home/termihoe/llama.cpp/build/bin/llama-server

# AI-CLI API URL (apunta a este servidor)
AI_API_URL=http://localhost:1234/v1/chat/completions
AI_BACKUP_DIR=.ai_backups
AI_VERBOSE=false

# --- TUNING: AMD Radeon RX 6600 (GPU Dedicated Offload) ---
AI_GPU_LAYERS=999
AI_CTX_SIZE=40960
AI_THREADS=6
AI_REASONING=on
AI_THINKING_LEVEL=high
AI_HARDWARE_MODE=AMD
AI_BATCH_SIZE=2048
AI_UBATCH_SIZE=512
AI_CACHE_TYPE_K=f16
AI_CACHE_TYPE_V=f16
