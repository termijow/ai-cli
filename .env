# --- MODELO ACTIVO ---
# Cambia entre perfiles con: ai models
MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILE=Qwen3.6-35B-A3B-UD-IQ2_XXS.gguf
PORT=1234

LLAMA_PATH=/home/termihoe/llama.cpp/build/bin/llama-server

# AI-CLI API URL (apunta a este servidor)
AI_API_URL=http://localhost:1234/v1/chat/completions
AI_BACKUP_DIR=.ai_backups
AI_VERBOSE=false

# --- TUNING: Qwen 3.6 35B A3B (MoE Híbrido SSM) + 40k contexto ---
# 28/40 capas en GPU RX 6600 (8GB) = ~6.8GB VRAM + KV cache 40k q4_0 = ~0.16GB → total ~7.2GB VRAM
# Offload a RAM: 12 capas en CPU (~3.4GB RAM de 22GB disponibles)
AI_GPU_LAYERS=25
AI_CTX_SIZE=40960
AI_THREADS=5
AI_REASONING=on
# Qwen thinking budget: low (~1K tokens), high (~8K), xhigh (~38K)
AI_THINKING_LEVEL=high

#   AI_THINKING_LEVEL                                            | --reasoning-budget                                           | Velocidad
#   --------------------------------------------------------------|--------------------------------------------------------------|-------------------------------------------------------------
#    off                                                          | 0                                                            | ⚡ Instantáneo
#    low                                                          | 1,024                                                        | 🟢 Rápido
#    high                                                         | 8,192                                                        | 🟡 Equilibrado (default)
#    xhigh                                                        | 38,912                                                       | 🔴 Lento, máxima profundidad
AI_HARDWARE_MODE=AMD
AI_BATCH_SIZE=2048
AI_UBATCH_SIZE=512
AI_CACHE_TYPE_K=q4_0
AI_CACHE_TYPE_V=q4_0
