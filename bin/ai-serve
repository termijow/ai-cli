#!/bin/bash

# 1. Detectar ubicación y cargar configuración del .env
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo .env\033[0m"
    exit 1
fi

# Exportar variables del .env
export $(grep -v '^#' "$ENV_FILE" | xargs)

# 2. Localización de llama-server
REAL_LLAMA_PATH=""
SEARCH_PATHS=(
    "$HOME/llama.cpp/build/bin/llama-server"
    "$HOME/llama.cpp/llama-server"
    "$(command -v llama-server 2>/dev/null)"
)

for path in "${SEARCH_PATHS[@]}"; do
    if [[ -n "$path" && -x "$path" ]]; then
        REAL_LLAMA_PATH="$path"
        break
    fi
done

if [[ -z "$REAL_LLAMA_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró llama-server. Ejecuta install.sh primero.\033[0m"
    exit 1
fi

# 3. Configuración de Hilos (90% de nproc)
TOTAL_CORES=$(nproc)
OPTIMIZED_THREADS=$(python3 -c "print(int($TOTAL_CORES * 0.9))")

# 4. Switch de Configuración por Hardware
case "$AI_HARDWARE_MODE" in
    AMD)
        echo "🔍 Verificando hardware AMD..."
        if ! rocminfo | grep 'Name:' | grep -qE 'gfx1032|RX 6600'; then
            echo "❌ ROCm no detecta la RX 6600. Revisa los drivers"
            exit 1
        fi

        export GGML_HIPBLAS=1

        echo "🔍 Verificando motor ROCm..."
        if ! "$REAL_LLAMA_PATH" --version 2>&1 | grep -iqE "HIP|ROCm|ggml_cuda_init"; then
            echo "❌ El binario no tiene soporte ROCm. Reinstala con la opción AMD"
            exit 1
        fi

        GPU_LAYERS=${AI_GPU_LAYERS:-30}
        CTX_SIZE=${AI_CTX_SIZE:-40000}
        BATCH_SIZE=512
        UBATCH_SIZE=256
        EXTRA_FLAGS="--jinja --flash-attn on --parallel 1 --cache-ram 16384 --context-shift --alias localmodel --reasoning-format none --predict -1"
        echo -e "\033[1;32m🚀 MODO AMD ROCm ACTIVO (RX 6600)\033[0m"
        ;;
    INTEL)
        GPU_LAYERS=999
        CTX_SIZE=8192
        BATCH_SIZE=512
        UBATCH_SIZE=512
        EXTRA_FLAGS="--jinja --flash-attn auto --alias localmodel"
        echo -e "\033[1;36m🚀 MODO INTEL VULKAN ACTIVO (Iris Xe)\033[0m"
        ;;
    *)
        GPU_LAYERS=0
        CTX_SIZE=4096
        BATCH_SIZE=128
        UBATCH_SIZE=128
        EXTRA_FLAGS="--jinja --alias localmodel"
        echo -e "\033[1;33m⚠️ MODO CPU ACTIVO\033[0m"
        ;;
esac

# 5. Localizar Modelo
MODELS_DIR="$HOME/models"
MODEL_PATH=$(find "$MODELS_DIR" "$HOME/.cache/huggingface" -name "$MODEL_FILE" 2>/dev/null | head -n 1)

if [[ -z "$MODEL_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró el modelo $MODEL_FILE\033[0m"
    exit 1
fi

# 6. Interfaz de inicio
echo -e "\033[0;34m╭──────────────────────────────────────────────────────────╮\033[0m"
echo -e "\033[0;34m│\033[0m \033[1;33m🔥 AI-SERVE: $AI_HARDWARE_MODE CONFIGURATION\033[0m            \033[0;34m│\033[0m"
echo -e "\033[0;34m├──────────────────────────────────────────────────────────┤\033[0m"
echo -e "\033[0;36m│\033[0m 🧠 Hilos:    \033[0;32m$OPTIMIZED_THREADS ($TOTAL_CORES detectados)\033[0m"
echo -e "\033[0;36m│\033[0m 📏 Contexto: \033[0;32m$CTX_SIZE tokens\033[0m"
echo -e "\033[0;36m│\033[0m 🚀 Offload:  \033[0;32m$GPU_LAYERS capas\033[0m"
echo -e "\033[0;34m╰──────────────────────────────────────────────────────────╯\033[0m"

# Configuración para usar la RX 6600 (GPU 0)
export HIP_VISIBLE_DEVICES=0
export HSA_OVERRIDE_GFX_VERSION=10.3.0
export HSA_NO_SCRATCH_REPLICATE=1
export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/hip/lib:$LD_LIBRARY_PATH

EXTRA_FLAGS=(
    --jinja
    --flash-attn on
    --parallel 1
    --cache-ram 4096
    --cache-type-k q8_0
    --cache-type-v q8_0
    --context-shift
    --alias localmodel
    --reasoning-format none
    --chat-template-kwargs '{"enable_thinking":false}'
    --predict 4096
    --no-mmap
)

# 7. Ejecución Directa (Comando Mandatorio)
# 7. Ejecución directa
exec "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --n-gpu-layers "$GPU_LAYERS" \
    --ctx-size "$CTX_SIZE" \
    --batch-size "$BATCH_SIZE" \
    --ubatch-size "$UBATCH_SIZE" \
    "${EXTRA_FLAGS[@]}"
