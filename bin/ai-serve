#!/bin/bash

# ==============================================================================
# AI-CLI SERVER MANAGER (llama.cpp ROCm/Vulkan/CPU Runner)
# ==============================================================================

# 1. Detectar ubicación y cargar configuración del .env de forma portable
_RAW_SRC="${BASH_SOURCE[0]:-$0}"
_CLEAN_SRC="${_RAW_SRC//\\//}"
_DIR="${_CLEAN_SRC%/*}"
[[ "$_DIR" == "$_CLEAN_SRC" ]] && _DIR="."
SCRIPT_DIR="$(cd -P "$_DIR" >/dev/null 2>&1 && pwd -P)"
PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd -P)"
if [[ -z "$PROJECT_ROOT" || "$PROJECT_ROOT" == "//" || "$PROJECT_ROOT" == "/" ]] && [[ -n "$AI_CLI_ROOT" ]]; then
    PROJECT_ROOT="$AI_CLI_ROOT"
fi

if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo .env\033[0m"
    exit 1
fi

# Cargar funciones de presets si están disponibles
if [[ -f "$PROJECT_ROOT/lib/presets.sh" ]]; then
    source "$PROJECT_ROOT/lib/presets.sh"
fi

# Exportar variables del .env
set -a
source "$ENV_FILE"
set +a

# 2. Localización de llama-server
IS_PRISM_MODEL=false
if [[ "$MODEL_FILE" =~ Ternary|Bonsai|PTQ1_0|PQ2_0 ]]; then
    IS_PRISM_MODEL=true
fi

REAL_LLAMA_PATH=""
if [[ "$IS_PRISM_MODEL" == "true" && -f "$PROJECT_ROOT/llama-prism/llama-server.exe" ]]; then
    REAL_LLAMA_PATH="$PROJECT_ROOT/llama-prism/llama-server.exe"
elif [[ "$IS_PRISM_MODEL" == "true" && -f "$PROJECT_ROOT/llama-prism/llama-server" ]]; then
    REAL_LLAMA_PATH="$PROJECT_ROOT/llama-prism/llama-server"
else
    SEARCH_PATHS=(
        "$LLAMA_PATH"
        "$PROJECT_ROOT/llama-bin/llama-server.exe"
        "$PROJECT_ROOT/llama-bin/llama-server"
        "$HOME/llama.cpp/llama-server.exe"
        "$HOME/llama.cpp/llama-server"
        "$HOME/llama.cpp/build/bin/llama-server"
        "C:/Users/USUARIO/llama.cpp/llama-server.exe"
        "C:/Users/USUARIO/Documents/ai-cli/llama-bin/llama-server.exe"
        "$(command -v llama-server 2>/dev/null)"
        "$(command -v llama-server.exe 2>/dev/null)"
    )

    for path in "${SEARCH_PATHS[@]}"; do
        if [[ -n "$path" && -x "$path" ]]; then
            REAL_LLAMA_PATH="$path"
            break
        fi
    done
fi

if [[ -z "$REAL_LLAMA_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró llama-server. Ejecuta install.sh primero.\033[0m"
    exit 1
fi

# 3. Cargar Preset específico del Modelo si existe
PRESET_FILE=""
if command -v find_preset_file &>/dev/null; then
    PRESET_FILE=$(find_preset_file "$MODEL_FILE")
    if [[ -n "$PRESET_FILE" && -f "$PRESET_FILE" ]]; then
        load_preset_vars "$PRESET_FILE"
    fi
fi

# 4. Configuración de Hilos Inteligente (Evita saturación del CPU)
if command -v nproc &>/dev/null && nproc &>/dev/null; then
    TOTAL_CORES=$(nproc)
else
    TOTAL_CORES=${NUMBER_OF_PROCESSORS:-6}
fi

PHYSICAL_CORES=""
if command -v lscpu &>/dev/null && lscpu &>/dev/null; then
    PHYSICAL_CORES=$(lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l)
fi
if [[ -z "$PHYSICAL_CORES" || "$PHYSICAL_CORES" -le 0 ]]; then
    if command -v powershell.exe &>/dev/null; then
        PHYSICAL_CORES=$(powershell.exe -NoProfile -Command "(Get-CimInstance Win32_Processor | Measure-Object -Property NumberOfCores -Sum).Sum" 2>/dev/null | tr -d '\r')
    fi
fi
[[ -z "$PHYSICAL_CORES" || "$PHYSICAL_CORES" -le 0 ]] && PHYSICAL_CORES=$(( TOTAL_CORES / 2 ))
if [[ "$PHYSICAL_CORES" -gt 2 ]]; then
    DEFAULT_THREADS=$(( PHYSICAL_CORES - 1 ))
else
    DEFAULT_THREADS=$PHYSICAL_CORES
fi
OPTIMIZED_THREADS=${AI_THREADS:-${PRESET_THREADS:-$DEFAULT_THREADS}}

# 5. Switch de Configuración por Hardware & Presets
AI_HARDWARE_MODE=${AI_HARDWARE_MODE:-AMD}
GPU_DEVICE_ARGS=()

case "$AI_HARDWARE_MODE" in
    CUDA|NVIDIA)
        echo "🔍 Verificando aceleración NVIDIA CUDA..."
        if command -v nvidia-smi &>/dev/null; then
            _nv_gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n1 || true)
            [[ -n "$_nv_gpu" ]] && echo -e "✦ GPU NVIDIA detectada: \033[1;32m$_nv_gpu\033[0m"
        fi
        if "$REAL_LLAMA_PATH" --list-devices 2>&1 | grep -iqE "CUDA0|CUDA"; then
            GPU_DEVICE_ARGS=(--device "CUDA0")
        else
            GPU_DEVICE_ARGS=()
        fi

        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-99}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-8192}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-2048}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-512}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-f16}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-f16}}
        ;;
    VULKAN)
        echo "🔍 Verificando aceleración Vulkan..."
        _vulkan_devs="$("$REAL_LLAMA_PATH" --list-devices 2>&1)"
        if [[ ! "$_vulkan_devs" =~ (Vulkan|AMD|Radeon) ]]; then
            echo "❌ No se detectó dispositivo Vulkan. Revisa los controladores."
            exit 1
        fi

        GPU_DEVICE_ARGS=(--device "Vulkan0")
        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-999}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-8192}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-512}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-256}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-q4_0}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-q4_0}}
        ;;
    AMD)
        echo "🔍 Verificando hardware AMD..."
        if ! rocminfo 2>/dev/null | grep 'Name:' | grep -qE 'gfx1030|gfx1032|RX 6600|Radeon'; then
            echo "❌ ROCm no detecta la GPU AMD. Revisa los drivers"
            exit 1
        fi

        export GGML_HIPBLAS=1

        # En HIP, GPU 0 corresponde a Agent 2 (gfx1032 / AMD Radeon RX 6600)
        export HIP_VISIBLE_DEVICES=0
        export ROCR_VISIBLE_DEVICES=0
        export HSA_OVERRIDE_GFX_VERSION=10.3.0
        export HSA_NO_SCRATCH_REPLICATE=1
        export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/hip/lib:$HOME/llama.cpp/build/bin:$LD_LIBRARY_PATH

        echo "🔍 Verificando motor ROCm..."
        if [ ! -f "$HOME/llama.cpp/build/bin/libggml-hip.so" ] && ! "$REAL_LLAMA_PATH" --list-devices 2>&1 | grep -iqE "HIP|ROCm|Radeon"; then
            echo "❌ El binario no tiene soporte ROCm. Ejecuta ./rebuild-rocm.sh para compilarlo."
            exit 1
        fi

        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-99}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-8192}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-2048}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-512}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-f16}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-f16}}
        ;;
    INTEL)
        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-999}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-4096}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-512}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-512}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-q4_0}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-q4_0}}
        ;;
    *)
        GPU_LAYERS=0
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-4096}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-128}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-128}}
        CACHE_TYPE_K="q4_0"
        CACHE_TYPE_V="q4_0"
        ;;
esac

# 6. Localizar Modelo en el sistema
MODELS_DIR="$HOME/models"
find_model() {
    local m="$1"
    local candidates=(
        "$m"
        "$PROJECT_ROOT/models/$m"
        "$PROJECT_ROOT/models/"*"/$m"
        "$HOME/models/$m"
        "$HOME/models/"*"/$m"
        "$MODELS_DIR/$m"
        "$MODELS_DIR/"*"/$m"
        "/c/Users/$USER/models/$m"
        "$HOME/.cache/huggingface/hub/"*"/$m"
    )
    shopt -s nullglob
    for cand in "${candidates[@]}"; do
        if [[ -f "$cand" ]]; then
            echo "$cand"
            return 0
        fi
    done
    return 1
}

MODEL_PATH=$(find_model "$MODEL_FILE")

if [[ -z "$MODEL_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo del modelo $MODEL_FILE\033[0m"
    echo "💡 Puedes descargarlo en models/ o elegir uno existente con 'ai select' o 'ai models'."
    exit 1
fi

PORT=${PORT:-1234}

# Liberar puerto o proceso anterior si está ocupado para evitar "couldn't bind HTTP server socket"
if command -v fuser &>/dev/null; then
    fuser -k -9 "$PORT"/tcp 2>/dev/null || true
elif command -v powershell.exe &>/dev/null; then
    powershell.exe -NoProfile -Command "
        Get-NetTCPConnection -LocalPort $PORT -ErrorAction SilentlyContinue |
        ForEach-Object { Stop-Process -Id \$_.OwningProcess -Force -ErrorAction SilentlyContinue }
    " 2>/dev/null || true
elif command -v taskkill &>/dev/null; then
    taskkill //F //IM "llama-server.exe" 2>/dev/null || true
fi
sleep 0.5
REASONING_FLAG=${AI_REASONING:-${PRESET_REASONING:-off}}
THINKING_LEVEL=${AI_THINKING_LEVEL:-${PRESET_THINKING_LEVEL:-off}}

# Reasoning Budget Mapping
case "$THINKING_LEVEL" in
    off)   REASONING_BUDGET=0     ; REASONING_FLAG="off" ;;
    low)   REASONING_BUDGET=1024  ;;
    high)  REASONING_BUDGET=8192  ;;
    xhigh) REASONING_BUDGET=38912 ;;
    *)     REASONING_BUDGET=0     ;;
esac

[[ "$REASONING_FLAG" == "off" ]] && REASONING_BUDGET=0

PRESET_DISPLAY_NAME="${PRESET_NAME:-Configuración Personalizada}"
PRESET_DISPLAY_TOKS="${PRESET_ESTIMATED_TOKS:-Estimado Variable}"
MAX_TOKENS="${AI_MAX_TOKENS:-${PRESET_MAX_TOKENS:-16384}}"

# Speculative Decoding / MTP / Fit / MMProj / Sampling variables
SPEC_TYPE="${AI_SPEC_TYPE:-${PRESET_SPEC_TYPE:-}}"
if [[ -z "$SPEC_TYPE" || "$SPEC_TYPE" == "none" ]]; then
    if [[ "${AI_MTP:-${PRESET_MTP:-}}" == "on" || "$MODEL_FILE" =~ MTP|mtp ]]; then
        SPEC_TYPE="draft-mtp"
    fi
fi
if [[ -z "$SPEC_TYPE" ]]; then
    SPEC_TYPE="none"
fi

SPEC_DRAFT_N_MAX="${AI_SPEC_DRAFT_N_MAX:-${PRESET_SPEC_DRAFT_N_MAX:-${AI_MTP_DRAFT_MAX:-${PRESET_MTP_DRAFT_MAX:-3}}}}"
MODEL_DRAFT="${AI_MODEL_DRAFT:-${PRESET_MODEL_DRAFT:-}}"
DRAFT_PATH=""
if [[ -n "$MODEL_DRAFT" ]]; then
    DRAFT_PATH=$(find_model "$MODEL_DRAFT")
    if [[ -z "$DRAFT_PATH" ]]; then
        echo -e "\033[0;33m⚠️ ADVERTENCIA: No se encontró el modelo draft '$MODEL_DRAFT'\033[0m"
    fi
fi

FIT_VAL="${AI_FIT:-${PRESET_FIT:-}}"
MMPROJ_VAL="${AI_MMPROJ:-${PRESET_MMPROJ:-}}"
MMPROJ_PATH=""
if [[ -n "$MMPROJ_VAL" ]]; then
    MMPROJ_PATH=$(find_model "$MMPROJ_VAL")
    if [[ -z "$MMPROJ_PATH" ]]; then
        echo -e "\033[0;33m⚠️ ADVERTENCIA: No se encontró el archivo mmproj '$MMPROJ_VAL'\033[0m"
    fi
fi

TEMP_VAL="${AI_TEMPERATURE:-${PRESET_TEMPERATURE:-}}"
TOP_P_VAL="${AI_TOP_P:-${PRESET_TOP_P:-}}"
TOP_K_VAL="${AI_TOP_K:-${PRESET_TOP_K:-}}"

# 7. Interfaz visual de inicio
echo -e "\033[0;34m╭──────────────────────────────────────────────────────────╮\033[0m"
echo -e "\033[0;34m│\033[0m \033[1;33m🔥 AI-SERVE: $AI_HARDWARE_MODE ENGINE\033[0m                       \033[0;34m│\033[0m"
echo -e "\033[0;34m├──────────────────────────────────────────────────────────┤\033[0m"
echo -e "\033[0;36m│\033[0m 📦 \033[1mModelo:\033[0m     \033[0;32m$MODEL_FILE\033[0m"
echo -e "\033[0;36m│\033[0m 🎯 \033[1mPreset:\033[0m     \033[1;33m$PRESET_DISPLAY_NAME\033[0m"
echo -e "\033[0;36m│\033[0m ⚡ \033[1mVelocidad:\033[0m  \033[1;32m$PRESET_DISPLAY_TOKS\033[0m"
echo -e "\033[0;36m│\033[0m 🧠 \033[1mHilos CPU:\033[0m  \033[0;32m$OPTIMIZED_THREADS ($PHYSICAL_CORES cores físicos)\033[0m"
echo -e "\033[0;36m│\033[0m 📏 \033[1mContexto:\033[0m   \033[0;32m$CTX_SIZE tokens\033[0m"
echo -e "\033[0;36m│\033[0m 🚀 \033[1mOffload:\033[0m    \033[0;32m$GPU_LAYERS capas en GPU\033[0m"
echo -e "\033[0;36m│\033[0m 💾 \033[1mKV Cache:\033[0m   \033[0;32mK: $CACHE_TYPE_K | V: $CACHE_TYPE_V\033[0m"
echo -e "\033[0;36m│\033[0m 📦 \033[1mBatch:\033[0m      \033[0;32mBatch: $BATCH_SIZE | UBatch: $UBATCH_SIZE\033[0m"
echo -e "\033[0;36m│\033[0m 💭 \033[1mThinking:\033[0m   \033[0;32m$REASONING_FLAG ($THINKING_LEVEL, budget: $REASONING_BUDGET)\033[0m"
if [[ "$SPEC_TYPE" != "none" ]]; then
    if [[ "$SPEC_TYPE" == "draft-mtp" ]]; then
        echo -e "\033[0;36m│\033[0m 🚀 \033[1mTurbo/MTP:\033[0m  \033[1;32mdraft-mtp ($SPEC_DRAFT_N_MAX tokens)\033[0m"
    elif [[ "$SPEC_TYPE" == "ngram-simple" ]]; then
        echo -e "\033[0;36m│\033[0m 🚀 \033[1mTurbo:\033[0m      \033[1;32mN-Gram Simple\033[0m"
    elif [[ "$SPEC_TYPE" == "draft-simple" ]]; then
        echo -e "\033[0;36m│\033[0m 🚀 \033[1mTurbo/Draft:\033[0m\033[1;32mdraft-simple ($SPEC_DRAFT_N_MAX tokens)\033[0m"
    else
        echo -e "\033[0;36m│\033[0m 🚀 \033[1mTurbo/Spec:\033[0m \033[1;32m$SPEC_TYPE ($SPEC_DRAFT_N_MAX tokens)\033[0m"
    fi
    if [[ -n "$MODEL_DRAFT" ]]; then
        echo -e "\033[0;36m│\033[0m 📎 \033[1mDraft Model:\033[0m\033[0;32m$MODEL_DRAFT\033[0m"
    fi
fi
if [[ -n "$FIT_VAL" ]]; then
    echo -e "\033[0;36m│\033[0m ⚖️ \033[1mFit Memory:\033[0m \033[0;32m$FIT_VAL\033[0m"
fi
if [[ -n "$MMPROJ_PATH" ]]; then
    echo -e "\033[0;36m│\033[0m 👁️ \033[1mVision/MM:\033[0m  \033[0;32m$(basename "$MMPROJ_PATH")\033[0m"
fi
echo -e "\033[0;36m│\033[0m 📤 \033[1mMax Tokens:\033[0m \033[0;32m$MAX_TOKENS tokens (salida)\033[0m"
echo -e "\033[0;36m│\033[0m 🌐 \033[1mEndpoint:\033[0m   \033[0;32mhttp://localhost:$PORT\033[0m"
echo -e "\033[0;34m╰──────────────────────────────────────────────────────────╯\033[0m"

EXTRA_FLAGS=(
    --jinja
    --flash-attn auto
    --parallel 1
    --cache-ram 4096
    --cache-type-k "$CACHE_TYPE_K"
    --cache-type-v "$CACHE_TYPE_V"
    --context-shift
    --alias localmodel
    --reasoning "$REASONING_FLAG" \
    --reasoning-budget "$REASONING_BUDGET" \
    --reasoning-format "${AI_REASONING_FORMAT:-auto}" \
    --predict "$MAX_TOKENS" \
)

if [[ "$SPEC_TYPE" != "none" ]]; then
    EXTRA_FLAGS+=(--spec-type "$SPEC_TYPE" --spec-draft-n-max "$SPEC_DRAFT_N_MAX")
    if [[ -n "$DRAFT_PATH" ]]; then
        EXTRA_FLAGS+=(--model-draft "$DRAFT_PATH")
    elif [[ -n "$MODEL_DRAFT" ]]; then
        EXTRA_FLAGS+=(--model-draft "$MODEL_DRAFT")
    fi
fi

if [[ -n "$FIT_VAL" ]]; then
    EXTRA_FLAGS+=(--fit "$FIT_VAL")
fi

if [[ -n "$MMPROJ_PATH" ]]; then
    EXTRA_FLAGS+=(-mm "$MMPROJ_PATH")
elif [[ -n "$MMPROJ_VAL" ]]; then
    EXTRA_FLAGS+=(-mm "$MMPROJ_VAL")
fi

if [[ -n "$TEMP_VAL" ]]; then
    EXTRA_FLAGS+=(--temp "$TEMP_VAL")
fi

if [[ -n "$TOP_P_VAL" ]]; then
    EXTRA_FLAGS+=(--top-p "$TOP_P_VAL")
fi

if [[ -n "$TOP_K_VAL" ]]; then
    EXTRA_FLAGS+=(--top-k "$TOP_K_VAL")
fi

# 8. Verificación previa de ejecución y compatibilidad
_test_run=$("$REAL_LLAMA_PATH" --help 2>&1 || true)
if echo "$_test_run" | grep -iqE "Control de aplicaciones|Application Control|bloqueó|0xc0000428"; then
    echo -e "\n\033[0;31m╭─────────────────────────────────────────────────────────────────────────────╮\033[0m"
    echo -e "\033[0;31m│ ❌ DIRECTIVA DE SEGURIDAD EN WINDOWS 11: SMART APP CONTROL (SAC)           │\033[0m"
    echo -e "\033[0;31m├─────────────────────────────────────────────────────────────────────────────┤\033[0m"
    echo -e "  Windows bloqueó la ejecución del motor personalizado: \033[1m$(basename "$REAL_LLAMA_PATH")\033[0m"
    echo -e "  (El modelo 27B Ternary requiere el fork de PrismML, el cual no está firmado por Microsoft)."
    echo -e "\n  \033[1;33m💡 PASOS PARA HABILITARLO EN WINDOWS (15 segundos):\033[0m"
    echo -e "  1. Presiona \033[1mWin + S\033[0m y busca \033[1mSeguridad de Windows\033[0m."
    echo -e "  2. Entra en \033[1mControl de aplicaciones y explorador\033[0m."
    echo -e "  3. En \033[1mControl inteligente de aplicaciones\033[0m, cámbialo a \033[1mDesactivado\033[0m (o Evaluación)."
    echo -e "  4. Vuelve a ejecutar \033[1mai serve\033[0m y correrá en tu GPU de inmediato."
    echo -e "\n  \033[1;36m🔄 MIENTRAS TANTO:\033[0m"
    echo -e "  Puedes seguir usando \033[1mGemma 4\033[0m o \033[1mLing 3.0\033[0m seleccionándolos con: \033[1mai models\033[0m"
    echo -e "\033[0;31m╰─────────────────────────────────────────────────────────────────────────────╯\033[0m\n"
    exit 1
fi

if [[ "$IS_PRISM_MODEL" == "true" && "$REAL_LLAMA_PATH" != *llama-prism* ]]; then
    echo -e "\n\033[0;31m❌ ERROR DE COMPATIBILIDAD DE MODELO:\033[0m"
    echo -e "   El modelo \033[1m$MODEL_FILE\033[0m usa la cuantización ternaria PTQ1_0 (tipo 143)."
    echo -e "   llama.cpp estándar solo admite tipos [0, 43)."
    echo -e "   Para correr este modelo necesitas el binario en \033[1mllama-prism/\033[0m con Smart App Control desactivado."
    echo -e "   Elige otro modelo compatible con: \033[1mai models\033[0m\n"
    exit 1
fi

# 9. Ejecución directa de llama-server
exec "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --n-gpu-layers "$GPU_LAYERS" \
    --ctx-size "$CTX_SIZE" \
    --batch-size "$BATCH_SIZE" \
    --ubatch-size "$UBATCH_SIZE" \
    "${GPU_DEVICE_ARGS[@]}" \
    "${EXTRA_FLAGS[@]}"
