#!/bin/bash

# 1. Detectar ubicación y cargar configuración del .env
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo .env\033[0m"
    exit 1
fi

# Exportar variables del .env
export $(grep -v '^#' "$ENV_FILE" | xargs)

# 2. Localización de llama-server
REAL_LLAMA_PATH=""
SEARCH_PATHS=(
    "$HOME/llama.cpp/build/bin/llama-server"
    "$HOME/llama.cpp/llama-server"
    "$(command -v llama-server 2>/dev/null)"
)

for path in "${SEARCH_PATHS[@]}"; do
    if [[ -n "$path" && -x "$path" ]]; then
        REAL_LLAMA_PATH="$path"
        break
    fi
done

if [[ -z "$REAL_LLAMA_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró llama-server. Ejecuta install.sh primero.\033[0m"
    exit 1
fi

# 3. Configuración de Hilos Inteligente (Evita congelamiento del sistema)
TOTAL_CORES=$(nproc)
PHYSICAL_CORES=$(lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l)
[[ -z "$PHYSICAL_CORES" || "$PHYSICAL_CORES" -eq 0 ]] && PHYSICAL_CORES=$(( TOTAL_CORES / 2 ))
if [[ "$PHYSICAL_CORES" -gt 2 ]]; then
    DEFAULT_THREADS=$(( PHYSICAL_CORES - 1 ))
else
    DEFAULT_THREADS=$PHYSICAL_CORES
fi
OPTIMIZED_THREADS=${AI_THREADS:-$DEFAULT_THREADS}

# 4. Switch de Configuración por Hardware
case "$AI_HARDWARE_MODE" in
    AMD)
        echo "🔍 Verificando hardware AMD..."
        if ! rocminfo 2>/dev/null | grep 'Name:' | grep -qE 'gfx1030|gfx1032|RX 6600|Radeon'; then
            echo "❌ ROCm no detecta la GPU AMD. Revisa los drivers"
            exit 1
        fi

        export GGML_HIPBLAS=1

        echo "🔍 Verificando motor ROCm..."
        if [ ! -f "$HOME/llama.cpp/build/bin/libggml-hip.so" ] && ! "$REAL_LLAMA_PATH" --list-devices 2>&1 | grep -iqE "HIP|ROCm|Radeon"; then
            echo "❌ El binario no tiene soporte ROCm. Ejecuta ./rebuild-rocm.sh para compilarlo."
            exit 1
        fi

        GPU_LAYERS=${AI_GPU_LAYERS:-35}
        CTX_SIZE=${AI_CTX_SIZE:-4096}
        BATCH_SIZE=512
        UBATCH_SIZE=256
        echo -e "\033[1;32m🚀 MODO AMD ROCm ACTIVO (RX 6600)\033[0m"
        ;;
    INTEL)
        GPU_LAYERS=${AI_GPU_LAYERS:-999}
        CTX_SIZE=${AI_CTX_SIZE:-4096}
        BATCH_SIZE=512
        UBATCH_SIZE=512
        echo -e "\033[1;36m🚀 MODO INTEL VULKAN ACTIVO (Iris Xe)\033[0m"
        ;;
    *)
        GPU_LAYERS=0
        CTX_SIZE=${AI_CTX_SIZE:-4096}
        BATCH_SIZE=128
        UBATCH_SIZE=128
        echo -e "\033[1;33m⚠️ MODO CPU ACTIVO\033[0m"
        ;;
esac

# 5. Localizar Modelo
MODELS_DIR="$HOME/models"
MODEL_PATH=$(find "$MODELS_DIR" "$HOME/.cache/huggingface" -name "$MODEL_FILE" 2>/dev/null | head -n 1)

if [[ -z "$MODEL_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró el modelo $MODEL_FILE\033[0m"
    echo "💡 Puedes usar 'ai select' o 'ai models' para elegir un modelo existente."
    exit 1
fi

# 6. Interfaz de inicio
echo -e "\033[0;34m╭──────────────────────────────────────────────────────────╮\033[0m"
echo -e "\033[0;34m│\033[0m \033[1;33m🔥 AI-SERVE: $AI_HARDWARE_MODE CONFIGURATION\033[0m            \033[0;34m│\033[0m"
echo -e "\033[0;34m├──────────────────────────────────────────────────────────┤\033[0m"
echo -e "\033[0;36m│\033[0m 📦 Modelo:   \033[0;32m$MODEL_FILE\033[0m"
echo -e "\033[0;36m│\033[0m 🧠 Hilos:    \033[0;32m$OPTIMIZED_THREADS ($PHYSICAL_CORES cores físicos, $TOTAL_CORES hilos)\033[0m"
echo -e "\033[0;36m│\033[0m 📏 Contexto: \033[0;32m$CTX_SIZE tokens\033[0m"
echo -e "\033[0;36m│\033[0m 🚀 Offload:  \033[0;32m$GPU_LAYERS capas en GPU\033[0m"
echo -e "\033[0;36m│\033[0m 🌐 Web UI:   \033[0;32mhttp://localhost:$PORT\033[0m"
echo -e "\033[0;34m╰──────────────────────────────────────────────────────────╯\033[0m"

# Configuración para usar la RX 6600 (GPU 0)
export HIP_VISIBLE_DEVICES=0
export HSA_OVERRIDE_GFX_VERSION=10.3.0
export HSA_NO_SCRATCH_REPLICATE=1
export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/hip/lib:$HOME/llama.cpp/build/bin:$LD_LIBRARY_PATH

REASONING_FLAG=${AI_REASONING:-off}

# --- Thinking Budget (Qwen3 "thinking level") ---
# Maps AI_THINKING_LEVEL to --reasoning-budget token counts:
#   low   →  1024  tokens  (rapido, razonamiento básico)
#   high  →  8192  tokens  (equilibrado, recomendado)
#   xhigh →  38912 tokens  (máximo, lento pero profundo)
case "${AI_THINKING_LEVEL:-high}" in
    low)   REASONING_BUDGET=1024  ;;
    high)  REASONING_BUDGET=8192  ;;
    xhigh) REASONING_BUDGET=38912 ;;
    *)     REASONING_BUDGET=8192  ;;
esac

# Si el reasoning está apagado, forzar budget=0
[[ "$REASONING_FLAG" == "off" ]] && REASONING_BUDGET=0

echo -e "\033[0;36m│\033[0m 🧠 Thinking:  \033[0;32m${AI_THINKING_LEVEL:-high} (budget: ${REASONING_BUDGET} tokens)\033[0m"

EXTRA_FLAGS=(
    --jinja
    --flash-attn on
    --parallel 1
    --cache-ram 4096
    --cache-type-k q4_0
    --cache-type-v q4_0
    --context-shift
    --alias localmodel
    --reasoning "$REASONING_FLAG"
    --reasoning-budget "$REASONING_BUDGET"
    --reasoning-format none
    --predict 4096
)

# 7. Ejecución directa
exec "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --n-gpu-layers "$GPU_LAYERS" \
    --ctx-size "$CTX_SIZE" \
    --batch-size "$BATCH_SIZE" \
    --ubatch-size "$UBATCH_SIZE" \
    "${EXTRA_FLAGS[@]}"
