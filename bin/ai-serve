#!/bin/bash

# ==============================================================================
# AI-CLI SERVER MANAGER (llama.cpp ROCm/Vulkan/CPU Runner)
# ==============================================================================

# 1. Detectar ubicación y cargar configuración del .env
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo .env\033[0m"
    exit 1
fi

# Cargar funciones de presets si están disponibles
if [[ -f "$PROJECT_ROOT/lib/presets.sh" ]]; then
    source "$PROJECT_ROOT/lib/presets.sh"
fi

# Exportar variables del .env
set -a
source "$ENV_FILE"
set +a

# 2. Localización de llama-server
REAL_LLAMA_PATH=""
SEARCH_PATHS=(
    "$LLAMA_PATH"
    "$HOME/llama.cpp/build/bin/llama-server"
    "$HOME/llama.cpp/llama-server"
    "$(command -v llama-server 2>/dev/null)"
)

for path in "${SEARCH_PATHS[@]}"; do
    if [[ -n "$path" && -x "$path" ]]; then
        REAL_LLAMA_PATH="$path"
        break
    fi
done

if [[ -z "$REAL_LLAMA_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró llama-server. Ejecuta install.sh primero.\033[0m"
    exit 1
fi

# 3. Cargar Preset específico del Modelo si existe
PRESET_FILE=""
if command -v find_preset_file &>/dev/null; then
    PRESET_FILE=$(find_preset_file "$MODEL_FILE")
    if [[ -n "$PRESET_FILE" && -f "$PRESET_FILE" ]]; then
        load_preset_vars "$PRESET_FILE"
    fi
fi

# 4. Configuración de Hilos Inteligente (Evita saturación del CPU)
TOTAL_CORES=$(nproc)
PHYSICAL_CORES=$(lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l)
[[ -z "$PHYSICAL_CORES" || "$PHYSICAL_CORES" -eq 0 ]] && PHYSICAL_CORES=$(( TOTAL_CORES / 2 ))
if [[ "$PHYSICAL_CORES" -gt 2 ]]; then
    DEFAULT_THREADS=$(( PHYSICAL_CORES - 1 ))
else
    DEFAULT_THREADS=$PHYSICAL_CORES
fi
OPTIMIZED_THREADS=${AI_THREADS:-${PRESET_THREADS:-$DEFAULT_THREADS}}

# 5. Switch de Configuración por Hardware & Presets
AI_HARDWARE_MODE=${AI_HARDWARE_MODE:-AMD}

case "$AI_HARDWARE_MODE" in
    AMD)
        echo "🔍 Verificando hardware AMD..."
        if ! rocminfo 2>/dev/null | grep 'Name:' | grep -qE 'gfx1030|gfx1032|RX 6600|Radeon'; then
            echo "❌ ROCm no detecta la GPU AMD. Revisa los drivers"
            exit 1
        fi

        export GGML_HIPBLAS=1

        # En HIP, GPU 0 corresponde a Agent 2 (gfx1032 / AMD Radeon RX 6600)
        export HIP_VISIBLE_DEVICES=0
        export ROCR_VISIBLE_DEVICES=0
        export HSA_OVERRIDE_GFX_VERSION=10.3.0
        export HSA_NO_SCRATCH_REPLICATE=1
        export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/hip/lib:$HOME/llama.cpp/build/bin:$LD_LIBRARY_PATH

        echo "🔍 Verificando motor ROCm..."
        if [ ! -f "$HOME/llama.cpp/build/bin/libggml-hip.so" ] && ! "$REAL_LLAMA_PATH" --list-devices 2>&1 | grep -iqE "HIP|ROCm|Radeon"; then
            echo "❌ El binario no tiene soporte ROCm. Ejecuta ./rebuild-rocm.sh para compilarlo."
            exit 1
        fi

        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-99}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-8192}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-2048}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-512}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-f16}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-f16}}
        ;;
    INTEL)
        GPU_LAYERS=${AI_GPU_LAYERS:-${PRESET_GPU_LAYERS:-999}}
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-4096}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-512}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-512}}
        CACHE_TYPE_K=${AI_CACHE_TYPE_K:-${PRESET_CACHE_TYPE_K:-q4_0}}
        CACHE_TYPE_V=${AI_CACHE_TYPE_V:-${PRESET_CACHE_TYPE_V:-q4_0}}
        ;;
    *)
        GPU_LAYERS=0
        CTX_SIZE=${AI_CTX_SIZE:-${PRESET_CTX_SIZE:-4096}}
        BATCH_SIZE=${AI_BATCH_SIZE:-${PRESET_BATCH_SIZE:-128}}
        UBATCH_SIZE=${AI_UBATCH_SIZE:-${PRESET_UBATCH_SIZE:-128}}
        CACHE_TYPE_K="q4_0"
        CACHE_TYPE_V="q4_0"
        ;;
esac

# 6. Localizar Modelo en el sistema
MODELS_DIR="$HOME/models"
MODEL_PATH=$(find "$MODELS_DIR" "$HOME/.cache/huggingface" -name "$MODEL_FILE" 2>/dev/null | head -n 1)

if [[ -z "$MODEL_PATH" ]]; then
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo del modelo $MODEL_FILE en $MODELS_DIR\033[0m"
    echo "💡 Puedes usar 'ai select' o 'ai models' para elegir un modelo existente."
    exit 1
fi

PORT=${PORT:-1234}

# Liberar puerto o proceso anterior si está ocupado para evitar "couldn't bind HTTP server socket"
if lsof -i :"$PORT" &>/dev/null || fuser "$PORT"/tcp &>/dev/null; then
    echo -e "\033[1;33m⚠️  El puerto $PORT ya está en uso. Liberando proceso previo...\033[0m"
    fuser -k -9 "$PORT"/tcp 2>/dev/null || true
    sleep 0.5
fi
REASONING_FLAG=${AI_REASONING:-${PRESET_REASONING:-off}}
THINKING_LEVEL=${AI_THINKING_LEVEL:-${PRESET_THINKING_LEVEL:-off}}

# Reasoning Budget Mapping
case "$THINKING_LEVEL" in
    off)   REASONING_BUDGET=0     ; REASONING_FLAG="off" ;;
    low)   REASONING_BUDGET=1024  ;;
    high)  REASONING_BUDGET=8192  ;;
    xhigh) REASONING_BUDGET=38912 ;;
    *)     REASONING_BUDGET=0     ;;
esac

[[ "$REASONING_FLAG" == "off" ]] && REASONING_BUDGET=0

PRESET_DISPLAY_NAME="${PRESET_NAME:-Configuración Personalizada}"
PRESET_DISPLAY_TOKS="${PRESET_ESTIMATED_TOKS:-Estimado Variable}"

# 7. Interfaz visual de inicio
echo -e "\033[0;34m╭──────────────────────────────────────────────────────────╮\033[0m"
echo -e "\033[0;34m│\033[0m \033[1;33m🔥 AI-SERVE: $AI_HARDWARE_MODE ENGINE\033[0m                       \033[0;34m│\033[0m"
echo -e "\033[0;34m├──────────────────────────────────────────────────────────┤\033[0m"
echo -e "\033[0;36m│\033[0m 📦 \033[1mModelo:\033[0m     \033[0;32m$MODEL_FILE\033[0m"
echo -e "\033[0;36m│\033[0m 🎯 \033[1mPreset:\033[0m     \033[1;33m$PRESET_DISPLAY_NAME\033[0m"
echo -e "\033[0;36m│\033[0m ⚡ \033[1mVelocidad:\033[0m  \033[1;32m$PRESET_DISPLAY_TOKS\033[0m"
echo -e "\033[0;36m│\033[0m 🧠 \033[1mHilos CPU:\033[0m  \033[0;32m$OPTIMIZED_THREADS ($PHYSICAL_CORES cores físicos)\033[0m"
echo -e "\033[0;36m│\033[0m 📏 \033[1mContexto:\033[0m   \033[0;32m$CTX_SIZE tokens\033[0m"
echo -e "\033[0;36m│\033[0m 🚀 \033[1mOffload:\033[0m    \033[0;32m$GPU_LAYERS capas en GPU\033[0m"
echo -e "\033[0;36m│\033[0m 💾 \033[1mKV Cache:\033[0m   \033[0;32mK: $CACHE_TYPE_K | V: $CACHE_TYPE_V\033[0m"
echo -e "\033[0;36m│\033[0m 📦 \033[1mBatch:\033[0m      \033[0;32mBatch: $BATCH_SIZE | UBatch: $UBATCH_SIZE\033[0m"
echo -e "\033[0;36m│\033[0m 💭 \033[1mThinking:\033[0m   \033[0;32m$REASONING_FLAG ($THINKING_LEVEL, budget: $REASONING_BUDGET)\033[0m"
echo -e "\033[0;36m│\033[0m 🌐 \033[1mEndpoint:\033[0m   \033[0;32mhttp://localhost:$PORT\033[0m"
echo -e "\033[0;34m╰──────────────────────────────────────────────────────────╯\033[0m"

EXTRA_FLAGS=(
    --jinja
    --flash-attn auto
    --parallel 1
    --cache-ram 4096
    --cache-type-k "$CACHE_TYPE_K"
    --cache-type-v "$CACHE_TYPE_V"
    --context-shift
    --alias localmodel
    --reasoning "$REASONING_FLAG" \
    --reasoning-budget "$REASONING_BUDGET" \
    --reasoning-format none \
    --predict "${AI_MAX_TOKENS:-8192}" \
)

# 8. Ejecución directa de llama-server
exec "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --host 0.0.0.0 \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --n-gpu-layers "$GPU_LAYERS" \
    --ctx-size "$CTX_SIZE" \
    --batch-size "$BATCH_SIZE" \
    --ubatch-size "$UBATCH_SIZE" \
    "${EXTRA_FLAGS[@]}"
