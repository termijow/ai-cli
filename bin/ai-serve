#!/bin/bash

# 1. Detectar ubicación y cargar configuración del .env
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo "❌ ERROR: No se encontró el archivo .env"
    echo "Buscado en:"
    echo "  1. $PROJECT_ROOT/.env"
    [[ -n "$AI_CLI_ROOT" ]] && echo "  2. $AI_CLI_ROOT/.env" || echo "  2. \$AI_CLI_ROOT no está definida"
    exit 1
fi

export $(grep -v '^#' "$ENV_FILE" | xargs)

# Colores
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# 2. Rutas
REAL_LLAMA_PATH="${LLAMA_PATH/#\~/$HOME}"
MODELS_DIR="$HOME/models"

# 3. Validación de Puerto
PORT=${PORT:-8081}

# 4. Configuración de Hilos (12 detectados en tu sistema)
OPTIMIZED_THREADS=$(nproc)

# 5. Localizar Modelo
MODEL_PATH=$(find "$MODELS_DIR" "$HOME/.cache/huggingface" -name "$MODEL_FILE" 2>/dev/null | head -n 1)

# 6. Interfaz de inicio
echo -e "${RED}╭──────────────────────────────────────────────────────────╮${NC}"
echo -e "${RED}│${NC} ${YELLOW}🔥 MODO EXTREMO V2: OPTIMIZACIÓN DE HILOS (12)           ${NC}${RED}│${NC}"
echo -e "${RED}├──────────────────────────────────────────────────────────┤${NC}"
echo -e "${CYAN}│${NC} 📄 Modelo:   ${YELLOW}$MODEL_FILE${NC}"
echo -e "${CYAN}│${NC} 🧠 Hilos:    ${GREEN}$OPTIMIZED_THREADS cores lógicos${NC}"
echo -e "${CYAN}│${NC} 🚀 Optimiz.:  ${GREEN}NUMA Distribute + Flash Attention${NC}"
echo -e "${RED}╰──────────────────────────────────────────────────────────╯${NC}"

# 7. Ejecución Directa (Sin nice para evitar Permission Denied)
# Corregido --numa a 'distribute'
# Mantenemos --prio 3 para prioridad interna de hilos

exec "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --ctx-size 16384 \
    --n-predict -1 \
    --batch-size 2048 \
    --ubatch-size 512 \
    --prio 3 \
    --numa distribute \
    --flash-attn auto \
    --no-mmap \
    --cache-ram 0 \
    --host 0.0.0.0