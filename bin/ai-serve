#!/bin/bash

# ==============================================================================
# AI-CLI Server Orchestrator v8.0 - EXTREME CPU PERFORMANCE MODE
# ==============================================================================

# 1. Cargar configuración del .env
SOURCE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ENV_FILE="$SOURCE_DIR/../.env"

if [[ -f "$ENV_FILE" ]]; then
    export $(grep -v '^#' "$ENV_FILE" | xargs)
else
    echo "❌ ERROR: No se encontró el archivo .env"
    exit 1
fi

# Colores
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# 2. Rutas
REAL_LLAMA_PATH="${LLAMA_PATH/#\~/$HOME}"
MODELS_DIR="$HOME/models"

# 3. Validación de Puerto
PORT=${PORT:-8081}
if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null ; then
    echo -e "${RED}⚠️  ERROR: Puerto $PORT ocupado.${NC}"
    exit 1
fi

# 4. Configuración EXTREMA (90% CPU)
# Usamos el 100% de los hilos lógicos (nproc)
OPTIMIZED_THREADS=$(nproc)

# 5. Detección de Hardware
HAS_GPU=false
NGL=0
if command -v nvidia-smi &> /dev/null; then
    HAS_GPU=true
    GPU_TYPE="NVIDIA (CUDA)"
    NGL=999
elif command -v vulkaninfo &> /dev/null || clinfo &> /dev/null; then
    HAS_GPU=true
    GPU_TYPE="AMD/Integrated (Vulkan/OpenCL)"
    NGL=999
fi

# 6. Localizar Modelo
MODEL_PATH=$(find "$MODELS_DIR" "$HOME/.cache/huggingface" -name "$MODEL_FILE" 2>/dev/null | head -n 1)

if [[ -z "$MODEL_PATH" || ! -f "$MODEL_PATH" ]]; then
    echo -e "${RED}❌ ERROR: No se encontró $MODEL_FILE${NC}"
    exit 1
fi

# 7. Interfaz
echo -e "${RED}╭──────────────────────────────────────────────────────────╮${NC}"
echo -e "${RED}│${NC} ${YELLOW}🔥 MODO EXTREMO: MÁXIMO RENDIMIENTO CPU ACTIVADO${NC}        ${RED}│${NC}"
echo -e "${RED}├──────────────────────────────────────────────────────────┤${NC}"
echo -e "${CYAN}│${NC} 📄 Modelo:   ${YELLOW}$MODEL_FILE${NC}"
echo -e "${CYAN}│${NC} 🧠 Hilos:    ${GREEN}$OPTIMIZED_THREADS (100% Cores)${NC}"
echo -e "${CYAN}│${NC} ⚡ Prioridad: ${GREEN}Nivel -15 (Máxima)${NC}"
echo -e "${CYAN}│${NC} 🚀 Optimiz.:  ${GREEN}NUMA dist + Flash Attention${NC}"
echo -e "${RED}╰──────────────────────────────────────────────────────────╯${NC}"

# 8. Ejecución con Prioridad Máxima y NUMA
# --numa dist: Optimiza el acceso a la memoria para procesadores modernos.
# --threads / --threads-batch: Usamos el total de hilos.
# --batch-size 2048: Aumenta la carga de trabajo por ciclo.

exec nice -n -15 "$REAL_LLAMA_PATH" \
    --model "$MODEL_PATH" \
    --port "$PORT" \
    --threads "$OPTIMIZED_THREADS" \
    --threads-batch "$OPTIMIZED_THREADS" \
    --ctx-size 16384 \
    --n-predict -1 \
    --n-gpu-layers "$NGL" \
    --batch-size 2048 \
    --ubatch-size 512 \
    --prio 3 \
    --numa dist \
    --flash-attn auto \
    --no-mmap \
    --cache-ram 0 \
    --host 0.0.0.0