#!/bin/bash

# ==============================================================================
# AI-CLI Server Orchestrator v6.0 - High Performance & Safety
# ==============================================================================

# Cargar configuración del .env
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
PROJECT_ROOT="$(dirname "$BIN_DIR")"

if [[ ! -f "$PROJECT_ROOT/.env" ]]; then
    echo "❌ ERROR: No se encontró el archivo .env en $PROJECT_ROOT"
    exit 1
fi

source "$PROJECT_ROOT/.env"

# Colores y UI Estilo Gemini
BLUE='\033[0;34m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# 1. Validación de Puerto (Evitar colisiones)
if command -v lsof >/dev/null ; then
    if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null ; then
        echo -e "${RED}⚠️  ERROR: El puerto $PORT ya está ocupado por otro proceso.${NC}"
        echo -e "${BLUE}✦ Abortando para evitar colisiones.${NC}"
        exit 1
    fi
elif command -v ss >/dev/null ; then
    if ss -tuln | grep -q ":$PORT " ; then
        echo -e "${RED}⚠️  ERROR: El puerto $PORT ya está ocupado por otro proceso.${NC}"
        echo -e "${BLUE}✦ Abortando para evitar colisiones.${NC}"
        exit 1
    fi
fi

# 2. Resolución de Rutas
SERVER_BIN="${LLAMA_PATH/#\~/$HOME}"

# Verificación de Binario
if [[ ! -f "$SERVER_BIN" ]]; then
    echo -e "${RED}❌ ERROR: No se encontró llama-server en: $SERVER_BIN${NC}"
    exit 1
fi

# Búsqueda del Modelo
if [[ -f "$HOME/models/$MODEL_FILE" ]]; then
    MODEL_PATH="$HOME/models/$MODEL_FILE"
elif [[ -f "./$MODEL_FILE" ]]; then
    MODEL_PATH="./$MODEL_FILE"
else
    echo -e "${RED}❌ ERROR: No se encontró el modelo $MODEL_FILE en $HOME/models/ ni en el directorio actual.${NC}"
    exit 1
fi

# 3. Lanzamiento con Configuración Mandatoria
echo -e "${BLUE}🚀 Lanzando AI-CLI LLM Server...${NC}"
echo -e "${BLUE}📍 Puerto: $PORT${NC}"
echo -e "${BLUE}🧠 Contexto: 32768 (32k)${NC}"
echo -e "${BLUE}⚡ Flash Attention: auto${NC}"

# Ejecución (usando exec para transferir el proceso)
exec "$SERVER_BIN" \
    -m "$MODEL_PATH" \
    --port "$PORT" \
    -ngl 900 \
    --cache-ram 4096 \
    --host 0.0.0.0 \
    -c 131072 \
    --n-predict -1 \
    -np 1 \
    --flash-attn auto \
    --chat-template chatml \
    --alias gemma4 \
    "$@"
