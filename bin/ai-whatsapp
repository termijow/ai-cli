#!/usr/bin/env python3
"""
ai-whatsapp - AI-CLI WhatsApp Massive Chat Analyzer CLI
Processes WhatsApp conversations of any length in batches with Qwen 3.6 35B A3B,
maintains an incremental Obsidian CRM notebook with personal facts,
and syncs meetings/events directly to Google Calendar.
"""

import sys
import os
from pathlib import Path

# Paths
SCRIPT_PATH = Path(__file__).resolve()
PROJECT_ROOT = SCRIPT_PATH.parent.parent
VENV_PYTHON = PROJECT_ROOT / "venv" / "bin" / "python"

# Re-exec with virtualenv python if not already running in it
if VENV_PYTHON.exists() and sys.executable != str(VENV_PYTHON):
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON)] + sys.argv)
sys.path.insert(0, str(PROJECT_ROOT))
sys.path.insert(0, str(PROJECT_ROOT / "backend"))

import glob
import time
import asyncio

from backend.whatsapp_analyzer_engine import LargeChatAnalyzer, STORAGE_DIR
from backend.obsidian_vault_exporter import vault_exporter
from backend.google_calendar_sync import calendar_sync, GoogleCalendarSync
from backend.server import query_llama_cpp

try:
    from rich.console import Console
    from rich.progress import Progress, SpinnerColumn, BarColumn, TextColumn, TimeRemainingColumn, TaskProgressColumn
    from rich.panel import Panel
    from rich.table import Table
    from rich.markdown import Markdown
    RICH_AVAILABLE = True
    console = Console()
except ImportError:
    RICH_AVAILABLE = False


def print_banner():
    if RICH_AVAILABLE:
        console.print(Panel.fit(
            "[bold green]💬 AI-CLI WhatsApp Intelligence & Personal CRM[/bold green]\n"
            "[dim]Procesamiento por batches con Qwen 3.6 35B A3B + Memoria Obsidian + Google Calendar[/dim]",
            border_style="green"
        ))
    else:
        print("\n========================================================")
        print("💬 AI-CLI WhatsApp Intelligence & Personal CRM")
        print("========================================================\n")


def scan_for_chats() -> list:
    """Scan common folders for exported WhatsApp .txt files."""
    candidates = []
    search_dirs = [
        PROJECT_ROOT / "chats",
        Path.home() / "Downloads",
        Path.home() / "Descargas",
        Path.home() / "Documents",
        Path.home() / "Documents" / "Obsidian_WhatsApp_CRM",
        PROJECT_ROOT / "uploads",
        Path.cwd()
    ]

    for d in search_dirs:
        if d.exists():
            for p in d.glob("*WhatsApp*.txt"):
                if p.is_file() and p not in candidates:
                    candidates.append(p)
            for p in d.glob("*Chat de WhatsApp*.txt"):
                if p.is_file() and p not in candidates:
                    candidates.append(p)
            for p in d.glob("*.txt"):
                if p.is_file() and ("chat" in p.name.lower() or "whatsapp" in p.name.lower()) and p not in candidates:
                    candidates.append(p)

    return candidates


def list_saved_dossiers():
    """List previously analyzed profiles."""
    md_files = list(STORAGE_DIR.glob("*_dossier.md"))
    if not md_files:
        print(f"No hay dossiers guardados aún en {STORAGE_DIR}")
        return

    if RICH_AVAILABLE:
        table = Table(title="📁 Dossiers y Perfiles Guardados en Memoria", border_style="green")
        table.add_column("Contacto / Chat", style="bold cyan")
        table.add_column("Tamaño", style="dim")
        table.add_column("Última Modificación", style="yellow")
        table.add_column("Ruta", style="dim")

        for f in md_files:
            stat = f.stat()
            mod_time = time.strftime("%Y-%m-%d %H:%M", time.localtime(stat.st_mtime))
            chat_name = f.stem.replace("_dossier", "").replace("_", " ").title()
            table.add_row(chat_name, f"{stat.st_size / 1024:.1f} KB", mod_time, str(f))

        console.print(table)
    else:
        print("Dossiers guardados:")
        for f in md_files:
            print(f"  • {f.name} ({f.stat().st_size} bytes)")


def list_obsidian_events():
    """Lists events detected in Obsidian CRM and their Google Calendar status."""
    events_dir = vault_exporter.events_dir
    event_files = list(events_dir.glob("*.md"))
    # Exclude aggregate agenda
    event_files = [f for f in event_files if f.name != "Compromisos_y_Eventos.md"]

    if not event_files:
        print("\n📅 No hay eventos ni salidas registradas en Obsidian CRM todavía.")
        return

    if RICH_AVAILABLE:
        table = Table(title="📅 Salidas y Eventos Detectados (WhatsApp ➔ Google Calendar)", border_style="cyan")
        table.add_column("Evento", style="bold green")
        table.add_column("Fecha", style="yellow")
        table.add_column("Hora", style="cyan")
        table.add_column("Lugar", style="magenta")
        table.add_column("Google Calendar", style="bold blue")

        for ef in sorted(event_files):
            try:
                content = ef.read_text(encoding="utf-8")
                title = ef.stem
                fecha = "N/A"
                hora = "N/A"
                lugar = "N/A"
                gcal_url = ""

                for line in content.splitlines():
                    if line.startswith("titulo:"):
                        title = line.split(":", 1)[1].strip().strip('"')
                    elif line.startswith("fecha:"):
                        fecha = line.split(":", 1)[1].strip().strip('"')
                    elif line.startswith("hora:"):
                        hora = line.split(":", 1)[1].strip().strip('"')
                    elif line.startswith("lugar:"):
                        lugar = line.split(":", 1)[1].strip().strip('"')
                    elif line.startswith("google_calendar_url:"):
                        gcal_url = line.split(":", 1)[1].strip().strip('"')

                link_display = f"[link={gcal_url}]Añadir (1 Clic)[/link]" if gcal_url else "Listo"
                table.add_row(title, fecha, hora, lugar or "No especificado", link_display)
            except Exception:
                continue

        console.print(table)
        print(f"\n💡 Libreta Obsidian: {events_dir}")
    else:
        print("\nEventos detectados:")
        for ef in sorted(event_files):
            print(f"  • {ef.stem}")


def show_dossier(query: str):
    """Display a stored dossier."""
    matches = list(STORAGE_DIR.glob(f"*{query}*_dossier.md"))
    if not matches:
        print(f"❌ No se encontró dossier que coincida con '{query}' en {STORAGE_DIR}")
        return

    target = matches[0]
    with open(target, "r", encoding="utf-8") as f:
        content = f.read()

    if RICH_AVAILABLE:
        console.print(Markdown(content))
    else:
        print(content)


def trigger_session_sync(contact_name: Optional[str] = None):
    """Launches Playwright WhatsApp Web session to export chats."""
    from backend.whatsapp_session_exporter import session_exporter
    print_banner()
    print("🚀 Abriendo sincronizador de WhatsApp Web...")
    print("Se abrirá una ventana para escanear el QR (solo la primera vez) o exportar tus chats activos.")
    
    out_file = asyncio.run(session_exporter.open_interactive_session(target_contact=contact_name))
    if out_file and out_file.exists():
        print(f"\n✅ Chat exportado con éxito a: {out_file}")
        resp = input("\n¿Deseas analizar este chat ahora mismo con Qwen 3.6? (y/n) [y]: ").strip().lower() or "y"
        if resp == "y":
            asyncio.run(run_analysis(out_file))


def trigger_batch_session_sync(limit: int = 100, scrolls: int = 8, auto_analyze: bool = False):
    """Launches Playwright WhatsApp Web session to export ALL chats automatically."""
    from backend.whatsapp_session_exporter import session_exporter
    print_banner()
    print("🚀 Abriendo exportador masivo automático de WhatsApp Web...")
    print(f"Se exportarán hasta {limit} conversaciones automáticamente a la carpeta 'chats/'.")
    print("Si no has iniciado sesión, se abrirá la ventana para escanear el QR.")

    exported_files = asyncio.run(session_exporter.export_all_chats(limit=limit, max_scrolls_per_chat=scrolls))
    if exported_files:
        print(f"\n✅ Se exportaron {len(exported_files)} chats exitosamente.")
        if auto_analyze:
            print("\n🧠 Iniciando análisis automático de todos los chats con Qwen 3.6...")
            for f in exported_files:
                asyncio.run(run_analysis(f))
        else:
            resp = input("\n¿Deseas procesar y analizar todos estos chats con Qwen 3.6 para tu libreta Obsidian CRM? (y/n) [y]: ").strip().lower() or "y"
            if resp == "y":
                for f in exported_files:
                    asyncio.run(run_analysis(f))


def run_batch_analysis():
    """Analyzes all .txt files found in chats/ folder."""
    candidates = scan_for_chats()
    if not candidates:
        print("❌ No se encontraron chats en la carpeta 'chats/' para analizar.")
        return
    print_banner()
    print(f"🧠 Se procesarán {len(candidates)} conversaciones en lote con Qwen 3.6 35B A3B...")
    for idx, c in enumerate(candidates, 1):
        print(f"\n[{idx}/{len(candidates)}] Procesando: {c.name}")
        asyncio.run(run_analysis(c))


async def run_analysis(file_path: Path):
    """Run full batched analysis on chat file with progress bar."""
    print_banner()

    if not file_path.exists():
        print(f"❌ Archivo no encontrado: {file_path}")
        return

    file_size_mb = file_path.stat().st_size / (1024 * 1024)
    chat_title = file_path.stem.replace("Chat de WhatsApp con ", "").replace("WhatsApp Chat with ", "").strip()

    if RICH_AVAILABLE:
        console.print(f"📄 [bold]Archivo:[/bold] {file_path.name} ({file_size_mb:.2f} MB)")
        console.print(f"👤 [bold]Conversación:[/bold] [cyan]{chat_title}[/cyan]")
        console.print(f"🧠 [bold]Modelo:[/bold] [magenta]Qwen 3.6 35B A3B Local (40k Context)[/magenta]")
    else:
        print(f"Archivo: {file_path.name} ({file_size_mb:.2f} MB)")
        print(f"Conversación: {chat_title}")
        print("Modelo: Qwen 3.6 35B A3B Local (40k Context)")

    # Read chat content
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            raw_text = f.read()
    except UnicodeDecodeError:
        with open(file_path, "r", encoding="latin-1") as f:
            raw_text = f.read()

    # With Qwen 3.6 35B A3B 40k context, batch size of 200 messages is fast and accurate
    engine = LargeChatAnalyzer(chunk_size_messages=200)

    # Prepare LLM query wrapper
    def call_llm_sync(prompt: str) -> dict:
        return query_llama_cpp(
            prompt,
            system_prompt="Eres un extractor de datos de WhatsApp. Responde directamente con el bloque JSON solicitado.",
            max_tokens=3000,
            temperature=0.1
        )

    if RICH_AVAILABLE and sys.stdout.isatty():
        with Progress(
            SpinnerColumn(),
            TextColumn("[bold green]{task.description}"),
            BarColumn(bar_width=40),
            TaskProgressColumn(),
            TimeRemainingColumn(),
            console=console
        ) as progress:

            main_task = progress.add_task("Analizando conversación...", total=100)
            final_dossier = None

            async for event in engine.analyze_chat_stream(raw_text, call_llm_sync, chat_title=chat_title):
                event_type = event.get("type")

                if event_type == "init":
                    progress.update(
                        main_task,
                        description=f"[cyan]{chat_title}[/cyan] ({event['total_messages']:,} msgs en {event['total_chunks']} batches)",
                        completed=event.get("percent", 10)
                    )
                elif event_type == "batch_start":
                    progress.update(
                        main_task,
                        description=f"[yellow]Batch {event['batch_index']}/{event['total_batches']}:[/yellow] {event['date_range']}",
                        completed=event.get("percent", 20)
                    )
                elif event_type == "batch_complete":
                    progress.update(
                        main_task,
                        completed=event.get("percent", 50)
                    )
                elif event_type == "complete":
                    progress.update(main_task, description="[bold green]✓ Análisis completado[/bold green]", completed=100)
                    final_dossier = event

            if final_dossier:
                console.print(Panel(
                    f"[bold green]✨ Inteligencia Extraída y Guardada Exitosamente[/bold green]\n\n"
                    f"📁 [bold]Dossier Local:[/bold] {final_dossier['saved_md']}\n"
                    f"📓 [bold]Libreta Obsidian CRM:[/bold] {vault_exporter.contacts_dir / f'{chat_title}.md'}\n"
                    f"📅 [bold]Eventos y Salidas:[/bold] {vault_exporter.events_dir}\n"
                    f"⚡ [bold]Tokens Procesados:[/bold] {final_dossier.get('total_tokens_spent', 0):,}",
                    border_style="green"
                ))

                # Print Markdown dossier preview
                console.print("\n" + "="*50 + " DOSSIER RESUMEN " + "="*50)
                console.print(Markdown(final_dossier["markdown_dossier"]))

    else:
        print("\n🚀 Iniciando procesamiento por batches con Qwen 3.6...")
        final_dossier = None
        async for event in engine.analyze_chat_stream(raw_text, call_llm_sync, chat_title=chat_title):
            etype = event.get("type")
            if etype == "init":
                print(f"✓ Chat estructurado: {event['total_messages']} mensajes en {event['total_chunks']} fragmentos.")
            elif etype == "batch_start":
                print(f"  [>] Fragmento {event['batch_index']}/{event['total_batches']} ({event['date_range']}) [Progreso: {event.get('percent')}%]")
            elif etype == "batch_complete":
                print(f"  [✓] Fragmento {event['batch_index']}/{event['total_batches']} procesado con éxito.")
            elif etype == "complete":
                final_dossier = event
                print(f"\n✅ ¡Análisis completado al 100%! Dossier guardado en:\n  📁 {event['saved_md']}\n  📓 Obsidian: {vault_exporter.vault_path}")

        if final_dossier:
            print("\n" + "="*50 + " DOSSIER RESUMEN " + "="*50)
            print(final_dossier["markdown_dossier"])


def interactive_select():
    """Scan and let user choose a chat to analyze."""
    print_banner()
    print("🔍 Buscando exportaciones de WhatsApp en tu equipo...")
    candidates = scan_for_chats()

    if not candidates:
        print("\n⚠️ No se encontraron archivos de chat automáticamente.")
        print("Puedes sincronizar desde WhatsApp Web o indicar la ruta de un archivo.")
        print("\nOpciones:")
        print("  1) 🚀 Exportar TODOS mis chats automáticamente desde WhatsApp Web (Modo Masivo)")
        print("  2) Sincronizar chat específico desde WhatsApp Web")
        print("  3) Escribir ruta manual a un archivo .txt")
        ch = input("\nElige una opción [1]: ").strip() or "1"
        if ch == "1":
            lim_in = input("¿Cuántos chats deseas exportar como máximo? [100]: ").strip() or "100"
            limit = int(lim_in) if lim_in.isdigit() else 100
            trigger_batch_session_sync(limit=limit)
        elif ch == "2":
            trigger_session_sync()
        elif ch == "3":
            path_in = input("Introduce la ruta manual al archivo .txt del chat: ").strip()
            if path_in:
                asyncio.run(run_analysis(Path(path_in).expanduser().resolve()))
        return

    print(f"\nSe encontraron {len(candidates)} conversaciones listas:")
    for idx, c in enumerate(candidates, 1):
        size_kb = c.stat().st_size / 1024
        print(f"  {idx}) {c.name} ({size_kb:.1f} KB) - {c.parent}")

    print("\nAcciones Rápidas:")
    print("  a) 🚀 Exportar TODOS mis chats automáticamente desde WhatsApp Web (Modo Masivo)")
    print("  b) 🧠 Analizar TODOS los chats guardados en lote con Qwen 3.6")
    print("  s) Sincronizar chat individual desde sesión de WhatsApp Web")
    print("  0) Escribir ruta manual a un archivo .txt")

    choice = input("\nElige una opción [1]: ").strip() or "1"
    if choice.lower() == "a":
        lim_in = input("¿Cuántos chats deseas exportar como máximo? [100]: ").strip() or "100"
        limit = int(lim_in) if lim_in.isdigit() else 100
        trigger_batch_session_sync(limit=limit)
    elif choice.lower() == "b":
        run_batch_analysis()
    elif choice.lower() == "s":
        trigger_session_sync()
    elif choice == "0":
        path_in = input("Introduce la ruta al archivo .txt: ").strip()
        if path_in:
            asyncio.run(run_analysis(Path(path_in).expanduser().resolve()))
    else:
        try:
            sel_idx = int(choice) - 1
            if 0 <= sel_idx < len(candidates):
                asyncio.run(run_analysis(candidates[sel_idx]))
            else:
                print("Opción inválida.")
        except ValueError:
            print("Entrada inválida.")


def main():
    if len(sys.argv) == 1:
        interactive_select()
    else:
        raw_arg = sys.argv[1]
        cmd = raw_arg.lower()
        if Path(raw_arg).exists():
            asyncio.run(run_analysis(Path(raw_arg).expanduser().resolve()))
        elif cmd in ["list", "saved", "dossiers"]:
            list_saved_dossiers()
        elif cmd in ["events", "calendar", "eventos"]:
            list_obsidian_events()
        elif cmd in ["export-all", "sync-all", "exportall", "syncall"]:
            limit = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else 100
            auto_analyze = "--analyze" in sys.argv or "-a" in sys.argv
            trigger_batch_session_sync(limit=limit, auto_analyze=auto_analyze)
        elif cmd in ["analyze-all", "batch", "batch-analyze"]:
            run_batch_analysis()
        elif cmd in ["sync", "session", "web"]:
            target = sys.argv[2] if len(sys.argv) > 2 else None
            trigger_session_sync(target)
        elif cmd in ["crm", "obsidian", "contacts"]:
            status = vault_exporter.get_status()
            print("\n📓 Estado de Obsidian CRM Vault:")
            print(f"  • Ruta: {status['vault_path']}")
            print(f"  • Contactos registrados: {status['contacts_count']}")
            print(f"  • Eventos registrados: {status.get('events_count', 0)}")
            list_saved_dossiers()
        elif cmd in ["show", "view", "cat"] and len(sys.argv) > 2:
            show_dossier(sys.argv[2])
        elif cmd in ["scan", "find"]:
            interactive_select()
        elif Path(cmd).exists():
            asyncio.run(run_analysis(Path(cmd).expanduser().resolve()))
        else:
            print(f"Uso:")
            print(f"  ai whatsapp                       - Menú interactivo con opciones masivas")
            print(f"  ai whatsapp export-all [límite]   - Exportar automáticamente TODOS tus chats de WhatsApp")
            print(f"  ai whatsapp analyze-all           - Procesar todos los chats con Qwen 3.6 -> Obsidian")
            print(f"  ai whatsapp sync [contacto]       - Conectar a WhatsApp Web y exportar un chat")
            print(f"  ai whatsapp /ruta/chat.txt         - Analizar chat con Qwen 3.6 y guardar en Obsidian")
            print(f"  ai whatsapp calendar              - Ver eventos y enlaces directos a Google Calendar")
            print(f"  ai whatsapp crm                   - Ver contactos en la libreta Obsidian")
            print(f"  ai whatsapp show <contacto>       - Ver dossier detallado")


if __name__ == "__main__":
    main()
