#!/bin/bash

# Detectar ubicación del script
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

# Localizar .env
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo "❌ ERROR: No se encontró el archivo .env"
    echo "Buscado en:"
    echo "  1. $PROJECT_ROOT/.env"
    [[ -n "$AI_CLI_ROOT" ]] && echo "  2. $AI_CLI_ROOT/.env" || echo "  2. \$AI_CLI_ROOT no está definida"
    exit 1
fi

source "$ENV_FILE"

# --- Lógica de Comandos ---

install_model() {
    local URL="$1"
    if [[ -z "$URL" ]]; then
        echo "❌ Uso: ai install-model [URL]"
        exit 1
    fi
    
    # 1. Limpiar nombre del archivo (quitar parámetros de URL)
    local RAW_FILE_NAME=$(basename "$URL")
    local FILE_NAME="${RAW_FILE_NAME%%\?*}"
    local REPO_NAME=$(echo "$URL" | cut -d'/' -f4-5)

    echo "⬇️ Descargando $FILE_NAME desde $REPO_NAME..."
    mkdir -p ~/models
    
    if curl -L "$URL" -o "$HOME/models/$FILE_NAME"; then
        echo "✅ Descarga exitosa: ~/models/$FILE_NAME"
        
        # 2. Actualizar .env usando PROJECT_ROOT
        if [[ -f "$ENV_FILE" ]]; then
            sed -i "s|^MODEL_FILE=.*|MODEL_FILE=$FILE_NAME|" "$ENV_FILE"
            sed -i "s|^MODEL_REPO=.*|MODEL_REPO=$REPO_NAME|" "$ENV_FILE"
            echo "✅ Archivo .env actualizado ($ENV_FILE)"
        else
            echo "⚠️ Advertencia: No se pudo actualizar el .env porque no se encontró."
        fi

        # 3. Reiniciar ai-serve
        echo "🔄 Reiniciando ai-serve..."
        pkill -f "llama-server" || true
        if [[ -f "$PROJECT_ROOT/bin/ai-serve" ]]; then
            "$PROJECT_ROOT/bin/ai-serve" &
            echo "✅ Servidor reiniciado en segundo plano."
        else
            echo "❌ Error: No se encontró ai-serve para reiniciar."
        fi
    else
        echo "❌ Error: La descarga falló."
        exit 1
    fi
}

show_status() {
    local pid=$(pgrep -f "llama-server" | head -n 1)
    echo -e "\n\033[0;34m╭───────────────────────────────────────────────────╮\033[0m"
    echo -e "\033[0;34m│\033[0m \033[1;36m🔍 ESTADO DEL SISTEMA AI-CLI\033[0m                      \033[0;34m│\033[0m"
    echo -e "\033[0;34m├───────────────────────────────────────────────────┤\033[0m"
    echo -e "\033[0;34m│\033[0m 📦 Modelo Configurado: \033[1;32m$MODEL_FILE\033[0m"
    if [[ -n "$pid" ]]; then
        echo -e "\033[0;34m│\033[0m 🖥️  Servidor:           \033[1;32m● ONLINE (PID: $pid)\033[0m"
        echo -e "\033[0;34m│\033[0m 🌐 Puerto:             \033[1;33m$PORT\033[0m"
    else
        echo -e "\033[0;34m│\033[0m 🖥️  Servidor:           \033[1;31m○ OFFLINE (Ejecuta 'ai-serve')\033[0m"
    fi
    if command -v rocm-smi &>/dev/null; then
        local vram_used=$(rocm-smi --showmeminfo vram 2>/dev/null | grep "VRAM Total Used Memory" | head -n 1 | awk '{print $NF}')
        local vram_total=$(rocm-smi --showmeminfo vram 2>/dev/null | grep "VRAM Total Memory" | head -n 1 | awk '{print $NF}')
        if [[ -n "$vram_used" && -n "$vram_total" ]]; then
            local u_gb=$(awk "BEGIN {printf \"%.2f\", $vram_used / (1024*1024*1024)}")
            local t_gb=$(awk "BEGIN {printf \"%.2f\", $vram_total / (1024*1024*1024)}")
            echo -e "\033[0;34m│\033[0m 🎮 VRAM GPU (RX 6600):  \033[1;33m${u_gb} GB / ${t_gb} GB\033[0m"
        fi
    fi
    sync_savings --quiet
    local total_savings="0.00"
    [[ -f "$HOME/.ai_cli_savings" ]] && total_savings=$(cat "$HOME/.ai_cli_savings" 2>/dev/null || echo "0.00")
    echo -e "\033[0;34m│\033[0m 💸 Ahorro vs Fable 5:  \033[1;32m\$${total_savings} USD\033[0m"
    echo -e "\033[0;34m╰───────────────────────────────────────────────────╯\033[0m\n"
}

sync_savings() {
    if [[ -f "$PROJECT_ROOT/bin/ai-sync-savings.py" ]]; then
        python3 "$PROJECT_ROOT/bin/ai-sync-savings.py" "$@" 2>/dev/null || true
    fi
}

show_savings() {
    sync_savings --quiet
    local savings_file="$HOME/.ai_cli_savings"
    local db_file="$HOME/.ai_cli_db.db"
    local total_savings="0.00"
    if [[ -f "$savings_file" ]]; then
        total_savings=$(cat "$savings_file" 2>/dev/null || echo "0.00")
    fi

    # Contador total histórico de tokens ("desde siempre")
    local total_in=0
    local total_out=0
    local total_tokens=0

    if [[ -f "$db_file" ]]; then
        total_in=$(sqlite3 "$db_file" "SELECT COALESCE(SUM(input_tokens), 0) FROM usage_logs;" 2>/dev/null || echo 0)
        total_out=$(sqlite3 "$db_file" "SELECT COALESCE(SUM(output_tokens), 0) FROM usage_logs;" 2>/dev/null || echo 0)
        total_tokens=$((total_in + total_out))
    fi

    # Fallback al historial JSONL si la BD estuviera vacía
    if [[ "$total_tokens" -eq 0 && -f "$HOME/.ai_cli_history/queries.jsonl" ]]; then
        total_in=$(jq -s '[.[].prompt_tokens // 0] | add // 0' "$HOME/.ai_cli_history/queries.jsonl" 2>/dev/null || echo 0)
        total_out=$(jq -s '[.[].completion_tokens // 0] | add // 0' "$HOME/.ai_cli_history/queries.jsonl" 2>/dev/null || echo 0)
        total_tokens=$((total_in + total_out))
    fi

    # Formateo con separador de miles (ej: 12,537)
    local fmt_total=$(echo "$total_tokens" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')
    local fmt_in=$(echo "$total_in" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')
    local fmt_out=$(echo "$total_out" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')

    # Función auxiliar para alinear bordes de cajas ASCII dinámicamente
    _pad_card_line() {
        local text="$1"
        local has_emoji="${2:-0}"
        local plain=$(echo -e "$text" | sed "s/\x1b\[[0-9;]*m//g")
        local len=${#plain}
        [[ "$has_emoji" -eq 1 ]] && len=$((len + 1))
        local pad=$((57 - len))
        [[ $pad -lt 0 ]] && pad=0
        local spaces=$(printf "%*s" "$pad" "")
        printf "\033[0;32m│\033[0m %b%s \033[0;32m│\033[0m\n" "$text" "$spaces"
    }

    # UI Principal - Alcancía y Tokens de por vida
    echo -e "\n\033[0;32m╭───────────────────────────────────────────────────────────╮\033[0m"
    _pad_card_line "💸 \033[1;36mMI ALCANCÍA DE IA LOCAL (Histórico Total)\033[0m" 1
    echo -e "\033[0;32m├───────────────────────────────────────────────────────────┤\033[0m"
    _pad_card_line "💰 \033[1;33mAhorro Total Acumulado:\033[0m   \033[1;32m\$${total_savings} USD\033[0m" 1
    _pad_card_line "📊 \033[1;33mTokens Procesados:\033[0m       \033[1;36m${fmt_total} tokens\033[0m" 1
    _pad_card_line "   ├─ Input (Prompt):       \033[0;37m${fmt_in} tokens\033[0m" 0
    _pad_card_line "   └─ Output (Generación):  \033[0;37m${fmt_out} tokens\033[0m" 0
    echo -e "\033[0;32m╰───────────────────────────────────────────────────────────╯\033[0m"

    # Mostrar precio por token (Claude Fable 5)
    echo -e "\n\033[0;32m╭───────────────────────────────────────────────────────────╮\033[0m"
    _pad_card_line "📊 \033[1;36mTASA DE AHORRO (simulada Claude Fable 5)\033[0m" 1
    echo -e "\033[0;32m├───────────────────────────────────────────────────────────┤\033[0m"
    _pad_card_line "💰 Input (Prompt):  \033[0;32m\$10.00 / 1M tokens (\$0.000010/tok)\033[0m" 1
    _pad_card_line "💰 Output (Gener.): \033[0;32m\$50.00 / 1M tokens (\$0.000050/tok)\033[0m" 1
    echo -e "\033[0;32m╰───────────────────────────────────────────────────────────╯\033[0m"

    # Historial de consultas (Directo de la Base de Datos SQLite con fallback a queries.jsonl)
    echo -e "\n\033[0;32m╭─────────────────────────────────────────────────────────────────────────╮\033[0m"
    echo -e "\033[0;32m│\033[0m \033[1;36m📜 HISTORIAL RECIENTE (Últimas consultas registradas)\033[0m                   \033[0;32m│\033[0m"
    echo -e "\033[0;32m├─────────────────────────────────────────────────────────────────────────┤\033[0m"
    local has_rows=0
    if [[ -f "$db_file" ]]; then
        local count=1
        while IFS='|' read -r ts pt ct sv; do
            [[ -z "$ts" ]] && continue
            has_rows=1
            printf "\033[0;32m│\033[0m \033[1;33m%d.\033[0m %-19s | %6s in / %6s out | \033[0;32m+\$%-7s USD\033[0m         \033[0;32m│\033[0m\n" \
                "$count" "$ts" "$pt" "$ct" "$sv"
            ((count++))
        done < <(sqlite3 -separator "|" "$db_file" "
            SELECT 
                created_at,
                COALESCE(input_tokens, 0),
                COALESCE(output_tokens, 0),
                ROUND(COALESCE(input_tokens, 0) * 0.0000100 + COALESCE(output_tokens, 0) * 0.0000500, 4)
            FROM usage_logs
            ORDER BY id DESC
            LIMIT 5;" 2>/dev/null)
    fi

    if [[ "$has_rows" -eq 0 ]]; then
        local history_file="$HOME/.ai_cli_history/queries.jsonl"
        if [[ -f "$history_file" && -s "$history_file" ]]; then
            local count=1
            while IFS= read -r json_line; do
                [[ -z "$json_line" ]] && continue
                has_rows=1
                local ts=$(echo "$json_line" | jq -r '.timestamp // "N/A"' 2>/dev/null)
                local sv=$(echo "$json_line" | jq -r '.savings // 0' 2>/dev/null)
                local pt=$(echo "$json_line" | jq -r '.prompt_tokens // 0' 2>/dev/null)
                local ct=$(echo "$json_line" | jq -r '.completion_tokens // 0' 2>/dev/null)
                printf "\033[0;32m│\033[0m \033[1;33m%d.\033[0m %-19s | %6s in / %6s out | \033[0;32m+\$%-7s USD\033[0m         \033[0;32m│\033[0m\n" \
                    "$count" "$ts" "$pt" "$ct" "$sv"
                ((count++))
            done < <(tail -n 5 "$history_file")
        fi
    fi

    if [[ "$has_rows" -eq 0 ]]; then
        echo -e "\033[0;32m│\033[0m \033[1;31mNo hay historial de consultas registrado aún\033[0m                              \033[0;32m│\033[0m"
    fi
    echo -e "\033[0;32m╰─────────────────────────────────────────────────────────────────────────╯\033[0m\n"
}

# Si se llama sin argumentos, abrir el menú interactivo principal
if [[ $# -eq 0 ]]; then
    if [[ -f "$PROJECT_ROOT/bin/ai-menu" ]]; then
        exec "$PROJECT_ROOT/bin/ai-menu"
    elif [[ -f "$PROJECT_ROOT/bin/ai-models" ]]; then
        exec "$PROJECT_ROOT/bin/ai-models"
    fi
fi

handle_services() {
    local subaction="${1:-start}"
    shift 2>/dev/null || true
    if [[ ! -f "$PROJECT_ROOT/start-all.sh" ]]; then
        echo "❌ No se encontró start-all.sh."
        return 1
    fi

    case "$subaction" in
        stop|down)
            "$PROJECT_ROOT/start-all.sh" stop
            ;;
        status|check)
            if [[ -f "$PROJECT_ROOT/master.py" ]]; then
                "$PROJECT_ROOT/master.py" status
            else
                show_status
            fi
            ;;
        daemon|-d|--daemon)
            "$PROJECT_ROOT/start-all.sh" --daemon
            ;;
        restart)
            "$PROJECT_ROOT/start-all.sh" stop
            sleep 1
            "$PROJECT_ROOT/start-all.sh" --daemon
            ;;
        open|browse)
            local port=5173
            if curl -s http://localhost:5174 | grep -q "AI-CLI"; then
                port=5174
            fi
            if command -v xdg-open &>/dev/null; then
                xdg-open "http://localhost:$port" &>/dev/null &
                echo "🌐 Abriendo AI-CLI Studio en http://localhost:$port..."
            fi
            ;;
        start)
            exec "$PROJECT_ROOT/start-all.sh" "$@"
            ;;
        *)
            exec "$PROJECT_ROOT/start-all.sh" "$subaction" "$@"
            ;;
    esac
}

case "$1" in
    claude)
        shift
        if [[ -f "$PROJECT_ROOT/bin/ai-claude" ]]; then
            exec "$PROJECT_ROOT/bin/ai-claude" "$@"
        else
            exec claude --local "$@"
        fi
        ;;
    qwen)
        shift
        if [[ -f "$PROJECT_ROOT/bin/ai-qwen" ]]; then
            exec "$PROJECT_ROOT/bin/ai-qwen" "$@"
        else
            exec qwen "$@"
        fi
        ;;
    whatsapp|wa)
        shift
        if [[ -f "$PROJECT_ROOT/bin/ai-whatsapp" ]]; then
            exec "$PROJECT_ROOT/venv/bin/python" "$PROJECT_ROOT/bin/ai-whatsapp" "$@"
        else
            echo "❌ No se encontró ai-whatsapp."
        fi
        ;;
    services|service|studio|web|editor|start-all)
        shift
        handle_services "$@"
        ;;
    menu|tui|dashboard|ui)
        if [[ -f "$PROJECT_ROOT/bin/ai-menu" ]]; then
            "$PROJECT_ROOT/bin/ai-menu"
        else
            "$PROJECT_ROOT/bin/ai-models"
        fi
        ;;
    models|select|presets|preset|config)
        if [[ -f "$PROJECT_ROOT/bin/ai-models" ]]; then
            "$PROJECT_ROOT/bin/ai-models"
        else
            echo "❌ No se encontró el selector de modelos."
        fi
        ;;
    help|--help|-h)
        shift
        if [[ -f "$PROJECT_ROOT/bin/ai-help" ]]; then
            "$PROJECT_ROOT/bin/ai-help" "$@"
        else
            echo "❌ No se encontró el módulo de ayuda."
        fi
        ;;
    serve|start)
        if [[ -f "$PROJECT_ROOT/bin/ai-serve" ]]; then
            exec "$PROJECT_ROOT/bin/ai-serve"
        else
            echo "❌ No se encontró ai-serve."
        fi
        ;;
    stop)
        echo "🛑 Deteniendo servidores..."
        pkill -f "llama-server" 2>/dev/null || true
        pkill -f "uvicorn server:app" 2>/dev/null || true
        pkill -f "vite" 2>/dev/null || true
        echo "✓ Servidores detenidos."
        ;;
    restart)
        echo "🔄 Reiniciando servidor..."
        pkill -f "llama-server" 2>/dev/null || true
        sleep 1
        if [[ -f "$PROJECT_ROOT/bin/ai-serve" ]]; then
            exec "$PROJECT_ROOT/bin/ai-serve"
        fi
        ;;
    status)
        show_status
        if [[ -f "$PROJECT_ROOT/master.py" ]]; then
            "$PROJECT_ROOT/master.py" status
        fi
        ;;
    validate)
        if [[ -f "$PROJECT_ROOT/bin/ai-validate.sh" ]]; then
            "$PROJECT_ROOT/bin/ai-validate.sh"
        fi
        ;;
    install-model)
        install_model "$2"
        ;;
    db)
        DB_INIT="$PROJECT_ROOT/bin/ai-db-init.sh"
        if [[ -f "$DB_INIT" ]]; then
            "$DB_INIT"
        else
            echo "❌ No se encontró el script de inicialización de BD."
        fi
        ;;
    log)
        STATS_SH="$PROJECT_ROOT/bin/ai-stats.sh"
        if [[ -f "$STATS_SH" ]]; then
            "$STATS_SH" log "$2" "$3"
        else
            echo "❌ No se encontró el script de estadísticas."
        fi
        ;;
    stats)
        STATS_SH="$PROJECT_ROOT/bin/ai-stats.sh"
        if [[ -f "$STATS_SH" ]]; then
            "$STATS_SH" stats
        else
            echo "❌ No se encontró el script de estadísticas."
        fi
        ;;
    show)
        case "$2" in
            recent|recents)
                "$PROJECT_ROOT/bin/show_recent.sh"
                ;;
            savings|saving|ahorros)
                show_savings
                ;;
            *)
                show_savings
                ;;
        esac
        ;;
    recent|recents|history|show-recent|show-recents)
        "$PROJECT_ROOT/bin/show_recent.sh"
        ;;
    savings|saving|ahorro|ahorros)
        show_savings
        ;;
    sync|sync-savings|sync-qwen)
        shift
        sync_savings "$@"
        ;;
    *)
        # Ejecutar el núcleo de AI-CLI
        CORE_SH="$PROJECT_ROOT/lib/core.sh"
        if [[ -f "$CORE_SH" ]]; then
            "$CORE_SH" "$@"
        else
            echo "❌ ERROR: No se encontró $CORE_SH"
            exit 1
        fi
        ;;
esac