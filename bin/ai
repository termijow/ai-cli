#!/bin/bash

# Cargar .env
ENV_FILE="$HOME/Documents/ai-cli/.env"
source "$ENV_FILE"

case "$1" in
  install-model)
    URL="$2"
    if [[ -z "$URL" ]]; then echo "❌ Uso: ai install-model [URL]"; exit 1; fi
    
RAW_FILE_NAME=$(basename "$URL")
FILE_NAME="${RAW_FILE_NAME%%\?*}"
    REPO_NAME=$(echo "$URL" | cut -d'/' -f4-5)

    echo "⬇️ Descargando $FILE_NAME..."
    mkdir -p ~/models
    cd ~/models || exit
    curl -L -O "$URL"
    
    if [[ $? -eq 0 ]]; then
        echo "✅ Descarga exitosa."
        # Actualizar .env usando sed
        sed -i "s|^MODEL_FILE=.*|MODEL_FILE=$FILE_NAME|" "$ENV_FILE"
        sed -i "s|^MODEL_REPO=.*|MODEL_REPO=$REPO_NAME|" "$ENV_FILE"
        echo "✅ .env actualizado."
        echo "✅ Modelo instalado y configurado. Reiniciando servidor..."
        pkill -f llama-server
        ai-serve &
    else
        echo "❌ Error: Descarga fallida. Borrando incompleto."
        rm -f "$FILE_NAME"
        exit 1
    fi
    ;;
  *)
    # Aquí iría tu lógica normal de chat/edición de ai-cli
    ~/Documents/ai-cli/lib/core.sh "$@"
    ;;
esac