#!/bin/bash
# ==============================================================================
# AI-CLI ARENA WRAPPER
# ==============================================================================
_ARENA_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]:-$0}")" >/dev/null 2>&1 && pwd -P)"
PROJECT_ROOT="$(cd -P "$_ARENA_DIR/.." >/dev/null 2>&1 && pwd -P)"

if [[ -f "$PROJECT_ROOT/lib/core.sh" ]]; then
    source "$PROJECT_ROOT/lib/core.sh"
    PY="$PYTHON_CMD"
else
    PY="python"
fi

exec "$PY" "$PROJECT_ROOT/bin/ai-arena.py" "$@"
