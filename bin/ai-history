#!/bin/bash

# ==============================================================================
# AI-CLI HISTORY - Mostrar historial de consultas
# ==============================================================================

SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

# Cargar .env si existe
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    source "$PROJECT_ROOT/.env"
fi

HISTORY_FILE="$HOME/.ai_cli_history/queries.jsonl"

# Colores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
    echo -e "${BLUE}╭───────────────────────────────────────────╮${NC}"
    echo -e "${BLUE}│${NC} ${CYAN}AI-CLI History Viewer${NC}"
    echo -e "${BLUE}│${NC} ${CYAN}Muestra el historial de consultas recientes${NC}"
    echo -e "${BLUE}╰───────────────────────────────────────────╯${NC}"
    echo ""
    echo -e "${YELLOW}Uso:${NC} ai-history [opciones]"
    echo ""
    echo -e "${YELLOW}Opciones:${NC}"
    echo "  --limit N      Mostrar solo las últimas N consultas (default: 10)"
    echo "  --csv          Exportar historial a formato CSV"
    echo "  --json         Exportar historial a formato JSON"
    echo "  --clear        Borrar el historial"
    echo "  --help         Mostrar este mensaje de ayuda"
    echo ""
}

show_history() {
    if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
        echo -e "${RED}❌ No se encontró historial de consultas.${NC}"
        echo "   Las consultas se guardarán automáticamente después de usar el AI CLI."
        return 1
    fi

    local limit="${1:-10}"
    
    echo -e "${BLUE}╭───────────────────────────────────────────╮${NC}"
    echo -e "${BLUE}│${NC} ${CYAN}Historial de Consultas (${limit} recientes)${NC}"
    echo -e "${BLUE}╰───────────────────────────────────────────╯${NC}"
    echo ""
    
    # Leer las últimas N líneas
    local count=0
    local total=$(wc -l < "$HISTORY_FILE")
    
    # Contar líneas válidas (no vacías)
    local valid_lines=$(grep -c . "$HISTORY_FILE" 2>/dev/null || echo 0)
    local start=$((valid_lines - limit))
    if [[ $start -lt 0 ]]; then
        start=0
    fi
    
    echo -e "${YELLOW}# Timestamp\t\t\t# Tokens\t\t# Savings${NC}"
    echo -e "${YELLOW}────────────────────────────────────────────────────────────────────────"
    
    # Procesar cada línea
    local line_num=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        line_num=$((line_num + 1))
        [[ $line_num -lt $start ]] && continue
        
        # Parsear JSON usando jq o grep/sed
        if command -v jq &> /dev/null; then
            local timestamp=$(echo "$line" | jq -r '.timestamp' 2>/dev/null)
            local tokens=$(echo "$line" | jq -r '.prompt_tokens + .completion_tokens' 2>/dev/null)
            local savings=$(echo "$line" | jq -r '.savings' 2>/dev/null)
            
            printf "${CYAN}[%s]${NC} \t# %s \t# \$\%.4f\n" "$timestamp" "$tokens" "$savings"
        else
            echo "   [No se pudo procesar: falta jq]"
        fi
    done < <(tail -n "$limit" "$HISTORY_FILE")
    
    echo ""
    echo -e "${BLUE}└───────────────────────────────────────────┘${NC}"
    echo ""
    echo -e "Total de consultas: ${CYAN}${valid_lines}${NC}"
    
    # Calcular ahorros totales
    if command -v jq &> /dev/null; then
        local total_savings=$(jq -s '[.[].savings] | add // 0' "$HISTORY_FILE" 2>/dev/null)
        local total_tokens=$(jq -s '[.[].prompt_tokens + .completion_tokens] | add // 0' "$HISTORY_FILE" 2>/dev/null)
        echo -e "Tokens totales: ${CYAN}${total_tokens}${NC}"
        echo -e "Ahorros totales: ${GREEN}\$${total_savings} USD${NC}"
    fi
}

export_to_csv() {
    local output_file="${HISTORY_FILE%.jsonl}.csv"
    
    echo -e "${YELLOW}Exportando historial a CSV: ${output_file}${NC}"
    
    if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
        echo -e "${RED}❌ No hay historial para exportar.${NC}"
        return 1
    fi
    
    # Escribir encabezado
    echo "timestamp,prompt_tokens,completion_tokens,savings,total_savings" > "$output_file"
    
    # Procesar cada línea
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        
        if command -v jq &> /dev/null; then
            local ts=$(echo "$line" | jq -r '.timestamp' 2>/dev/null)
            local pt=$(echo "$line" | jq -r '.prompt_tokens' 2>/dev/null)
            local ct=$(echo "$line" | jq -r '.completion_tokens' 2>/dev/null)
            local sv=$(echo "$line" | jq -r '.savings' 2>/dev/null)
            local ts_tot=$(echo "$line" | jq -r '.total_savings' 2>/dev/null)
            
            echo "$ts,$pt,$ct,$sv,$ts_tot" >> "$output_file"
        fi
    done < "$HISTORY_FILE"
    
    echo -e "${GREEN}✓ Exportado: ${output_file}${NC}"
}

export_to_json() {
    local output_file="${HISTORY_FILE%.jsonl}.json"
    
    echo -e "${YELLOW}Exportando historial a JSON: ${output_file}${NC}"
    
    if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
        echo -e "${RED}❌ No hay historial para exportar.${NC}"
        return 1
    fi
    
    if command -v jq &> /dev/null; then
        jq -s '.' "$HISTORY_FILE" > "$output_file"
        echo -e "${GREEN}✓ Exportado: ${output_file}${NC}"
    else
        echo -e "${RED}❌ Falta jq para exportar a JSON.${NC}"
        return 1
    fi
}

clear_history() {
    if [[ ! -f "$HISTORY_FILE" ]]; then
        echo -e "${YELLOW}⚠️  No existe historial.${NC}"
        return 0
    fi
    
    local confirm
    read -p "${RED}¿Estás seguro de que quieres borrar todo el historial? (y/n): ${NC} " confirm
    
    if [[ "$confirm" == "y" ]] || [[ "$confirm" == "Y" ]]; then
        rm -f "$HISTORY_FILE"
        echo -e "${GREEN}✓ Historial borrado.${NC}"
        return 0
    else
        echo -e "${YELLOW}✗ Cancelado.${NC}"
        return 1
    fi
}

# Main
if [[ $# -eq 0 ]]; then
    show_history
else
    case "$1" in
        --limit)
            show_history "$2"
            ;;
        --csv)
            export_to_csv
            ;;
        --json)
            export_to_json
            ;;
        --clear)
            clear_history
            ;;
        --help|-h)
            show_help
            ;;
        *)
            echo -e "${RED}❌ Opción no válida: $1${NC}"
            show_help
            exit 1
            ;;
    esac
fi
