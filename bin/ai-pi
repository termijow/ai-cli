#!/bin/bash
# ==============================================================================
# AI-PI: Lanza Pi Coding Agent apuntando al servidor local (ai-serve)
# ==============================================================================

_SOURCE="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_SOURCE" ]]; do
    _DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd -P)"
    _SOURCE="$(readlink "$_SOURCE")"
    [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" >/dev/null 2>&1 && pwd -P)"
PROJECT_ROOT="$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd -P)"

# Cargar .env del proyecto
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    set -a; source "$PROJECT_ROOT/.env"; set +a
fi

PORT=${PORT:-1234}

export LLAMA_BASE_URL="http://127.0.0.1:${PORT}"
export OPENAI_BASE_URL="http://127.0.0.1:${PORT}/v1"
export OPENAI_API_KEY="local"

# Asegurar que ~/.local/bin esté en el PATH en Linux
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Omitir chequeo si se solicitan flags informativos
case "$1" in
    --help|-h|--version|-v|--list-models|list|config)
        PI_BIN="$(command -v pi 2>/dev/null || echo "$HOME/.local/bin/pi")"
        exec "$PI_BIN" "$@"
        ;;
esac

# Verificar si el servidor local está online
if ! curl -sf "http://127.0.0.1:${PORT}/health" > /dev/null 2>&1; then
    echo -e "\033[1;33m⚠️  El servidor local no está corriendo en http://127.0.0.1:${PORT}\033[0m"
    echo "   Tip: Ejecuta 'ai serve' o 'ai-serve' en otra terminal para iniciar el modelo local."
    echo ""
    read -rp "¿Continuar de todas formas con Pi? (s/n): " ans
    [[ "$ans" != "s" && "$ans" != "S" ]] && exit 1
fi

PI_BIN="$(command -v pi 2>/dev/null || echo "$HOME/.local/bin/pi")"

exec "$PI_BIN" "$@"
