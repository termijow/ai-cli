#!/bin/bash

# ==============================================================================
# AI-CLI TUI DASHBOARD & CONTROL CENTER
# ==============================================================================

SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")

# 1. Localizar .env
if [[ -f "$PROJECT_ROOT/.env" ]]; then
    ENV_FILE="$PROJECT_ROOT/.env"
elif [[ -n "$AI_CLI_ROOT" && -f "$AI_CLI_ROOT/.env" ]]; then
    ENV_FILE="$AI_CLI_ROOT/.env"
else
    echo -e "\033[0;31m❌ ERROR: No se encontró el archivo .env\033[0m"
    exit 1
fi

# Cargar presets
if [[ -f "$PROJECT_ROOT/lib/presets.sh" ]]; then
    source "$PROJECT_ROOT/lib/presets.sh"
fi

# Colores
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

get_server_status() {
    local pid=$(pgrep -f "llama-server" | head -n 1)
    if [[ -n "$pid" ]]; then
        echo -e "${GREEN}● ONLINE${NC} (PID: $pid)"
    else
        echo -e "${RED}○ OFFLINE${NC}"
    fi
}

get_vram_info() {
    if command -v rocm-smi &>/dev/null; then
        local vram_used=$(rocm-smi --showmeminfo vram 2>/dev/null | grep "VRAM Total Used Memory" | head -n 1 | awk '{print $NF}')
        local vram_total=$(rocm-smi --showmeminfo vram 2>/dev/null | grep "VRAM Total Memory" | head -n 1 | awk '{print $NF}')
        if [[ -n "$vram_used" && -n "$vram_total" && "$vram_total" -gt 0 ]]; then
            local used_gb=$(awk "BEGIN {printf \"%.2f\", $vram_used / (1024*1024*1024)}")
            local total_gb=$(awk "BEGIN {printf \"%.2f\", $vram_total / (1024*1024*1024)}")
            echo "${used_gb} GB / ${total_gb} GB"
            return
        fi
    fi
    echo "No disponible"
}

get_savings_total() {
    local savings_file="$HOME/.ai_cli_savings"
    if [[ -f "$savings_file" ]]; then
        cat "$savings_file" 2>/dev/null || echo "0.00"
    else
        echo "0.00"
    fi
}

manage_server_menu() {
    clear
    echo -e "${BLUE}╭──────────────────────────────────────────────────────────╮${NC}"
    echo -e "${BLUE}│${NC} ${YELLOW}⚡ CONTROL DEL SERVIDOR LLAMA.CPP${NC}                        ${BLUE}│${NC}"
    echo -e "${BLUE}├──────────────────────────────────────────────────────────┤${NC}"
    local s_status=$(get_server_status)
    echo -e "${BLUE}│${NC} Estado: $s_status"
    echo -e "${BLUE}╰──────────────────────────────────────────────────────────╯${NC}"
    echo ""
    echo "  1) 🚀 Iniciar Servidor (ai-serve)"
    echo "  2) 🛑 Detener Servidor"
    echo "  3) 🔄 Reiniciar Servidor"
    echo "  4) 📋 Ver Logs en Vivo"
    echo "  5) ↩ Volver"
    echo ""
    read -p "Elige una opción [1-5]: " s_opt
    case "$s_opt" in
        1)
            if pgrep -f "llama-server" &>/dev/null; then
                echo -e "${YELLOW}⚠️  El servidor ya está en ejecución.${NC}"
                read -p "Presiona ENTER para continuar..."
            else
                exec "$PROJECT_ROOT/bin/ai-serve"
            fi
            ;;
        2)
            echo -e "Deteniendo servidor..."
            pkill -f "llama-server" 2>/dev/null || true
            sleep 1
            echo -e "${GREEN}✓ Servidor detenido.${NC}"
            read -p "Presiona ENTER para continuar..."
            ;;
        3)
            echo -e "Reiniciando servidor..."
            pkill -f "llama-server" 2>/dev/null || true
            sleep 1
            exec "$PROJECT_ROOT/bin/ai-serve"
            ;;
        4)
            echo -e "${YELLOW}Consultando logs... Presiona CTRL+C para salir.${NC}"
            sleep 1
            # Si hay proceso corriendo, se muestra con journalctl o dmesg o si está en background
            read -p "Presiona ENTER para continuar..."
            ;;
        *)
            return
            ;;
    esac
}

show_presets_list() {
    clear
    echo -e "${BLUE}╭──────────────────────────────────────────────────────────╮${NC}"
    echo -e "${BLUE}│${NC} ${YELLOW}📁 PRESETS DISPONIBLES EN EL REPOSITORIO${NC}                 ${BLUE}│${NC}"
    echo -e "${BLUE}├──────────────────────────────────────────────────────────┤${NC}"
    
    local presets_files=("$PROJECT_ROOT"/presets/*.conf)
    local i=1
    for pf in "${presets_files[@]}"; do
        [[ ! -f "$pf" ]] && continue
        local fname=$(basename "$pf")
        local pname=$(grep "^AI_PRESET_NAME=" "$pf" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local ptoks=$(grep "^AI_ESTIMATED_TOKS=" "$pf" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local players=$(grep "^AI_GPU_LAYERS=" "$pf" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local pctx=$(grep "^AI_CTX_SIZE=" "$pf" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        
        printf "${BLUE}│${NC} ${BOLD}%2d)${NC} %-25s ${GREEN}%-12s${NC}\n" "$i" "$fname" "$ptoks"
        printf "${BLUE}│${NC}     ↳ ${CYAN}%s${NC} (Capas: %s, Ctx: %s)\n" "$pname" "$players" "$pctx"
        ((i++))
    done
    echo -e "${BLUE}╰──────────────────────────────────────────────────────────╯${NC}"
    echo ""
    echo -e "${YELLOW}💡 Puedes personalizar cualquier preset eligiendo el modelo en 'ai-models'.${NC}"
    echo ""
    read -p "Presiona ENTER para volver..."
}

main_menu() {
    while true; do
        clear
        # Cargar modelo actual
        local cur_model=$(grep "^MODEL_FILE=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local cur_layers=$(grep "^AI_GPU_LAYERS=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local cur_ctx=$(grep "^AI_CTX_SIZE=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local cur_think=$(grep "^AI_THINKING_LEVEL=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        local cur_server=$(get_server_status)
        local cur_vram=$(get_vram_info)
        local cur_savings=$(get_savings_total)

        # Preset actual
        local preset_file=$(find_preset_file "$cur_model" 2>/dev/null || echo "")
        local p_name="Personalizado"
        local p_toks="Variable"
        if [[ -n "$preset_file" && -f "$preset_file" ]]; then
            load_preset_vars "$preset_file"
            p_name="$PRESET_NAME"
            p_toks="$PRESET_ESTIMATED_TOKS"
        fi

        echo -e "${BLUE}╭──────────────────────────────────────────────────────────╮${NC}"
        echo -e "${BLUE}│${NC} ${BOLD}${YELLOW}🚀 AI-CLI: PANEL DE CONTROL Y CONFIGURACIÓN${NC}              ${BLUE}│${NC}"
        echo -e "${BLUE}├──────────────────────────────────────────────────────────┤${NC}"
        printf "${BLUE}│${NC} 📦 ${BOLD}Modelo Activo:${NC}   %-38s ${BLUE}│${NC}\n" "$cur_model"
        printf "${BLUE}│${NC} 🎯 ${BOLD}Preset:${NC}          %-38s ${BLUE}│${NC}\n" "$p_name"
        printf "${BLUE}│${NC} ⚡ ${BOLD}Rendimiento Est:${NC} %-38s ${BLUE}│${NC}\n" "$p_toks"
        printf "${BLUE}│${NC} 🖥️  ${BOLD}Servidor:${NC}        %-47b ${BLUE}│${NC}\n" "$cur_server"
        printf "${BLUE}│${NC} 🎮 ${BOLD}VRAM (RX 6600):${NC}  %-38s ${BLUE}│${NC}\n" "$cur_vram"
        printf "${BLUE}│${NC} 💸 ${BOLD}Ahorro Total:${NC}    \$%-37s ${BLUE}│${NC}\n" "$cur_savings USD"
        echo -e "${BLUE}╰──────────────────────────────────────────────────────────╯${NC}"
        echo ""
        echo -e "  ${BOLD}1)${NC} 🤖 ${GREEN}Seleccionar Modelo & Presets${NC} (ai-models)"
        echo -e "  ${BOLD}2)${NC} ⚡ ${YELLOW}Control del Servidor llama.cpp${NC} (Iniciar / Detener)"
        echo -e "  ${BOLD}3)${NC} ⚙️  ${CYAN}Ver Presets Guardados en el Repo${NC}"
        echo -e "  ${BOLD}4)${NC} 💸 ${GREEN}Alcancía de Ahorros & Estadísticas${NC} (ai savings)"
        echo -e "  ${BOLD}5)${NC} 📜 ${MAGENTA}Historial de Consultas Recientes${NC} (ai-history)"
        echo -e "  ${BOLD}6)${NC} 💡 ${BLUE}Centro de Ayuda & Guía (ai-help)${NC}"
        echo -e "  ${BOLD}7)${NC} 🔍 ${CYAN}Validar Sistema & Dependencias${NC} (ai-validate)"
        echo -e "  ${BOLD}0)${NC} 🚪 ${RED}Salir${NC}"
        echo ""
        read -p "Selecciona una opción [1-7, 0]: " menu_choice

        case "$menu_choice" in
            1)
                "$PROJECT_ROOT/bin/ai-models"
                ;;
            2)
                manage_server_menu
                ;;
            3)
                show_presets_list
                ;;
            4)
                "$PROJECT_ROOT/bin/ai" savings
                echo ""
                read -p "Presiona ENTER para continuar..."
                ;;
            5)
                "$PROJECT_ROOT/bin/ai-history" --limit 10
                echo ""
                read -p "Presiona ENTER para continuar..."
                ;;
            6)
                "$PROJECT_ROOT/bin/ai-help"
                echo ""
                read -p "Presiona ENTER para continuar..."
                ;;
            7)
                "$PROJECT_ROOT/bin/ai-validate.sh"
                echo ""
                read -p "Presiona ENTER para continuar..."
                ;;
            0|q|Q)
                echo -e "\n${GREEN}¡Hasta pronto!${NC}"
                exit 0
                ;;
            *)
                ;;
        esac
    done
}

main_menu
