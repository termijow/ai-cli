# Provider used for each fresh worker session.
# qwen is the default. Set opencode to use OpenCode instead.
LOCAL_WORKER_PROVIDER=qwen

# Only repositories below one of these paths can be delegated.
# Use an absolute, colon-separated list on Linux/macOS and semicolon-separated on Windows.
LOCAL_WORKER_ALLOWED_ROOTS=/home/your-user/projects

# Where temporary git worktrees are created.
LOCAL_WORKER_WORKTREE_ROOT=/tmp/local-worker-worktrees

# CLI configuration.
LOCAL_WORKER_QWEN_BIN=qwen
LOCAL_WORKER_QWEN_MODEL=localmodel
LOCAL_WORKER_QWEN_APPROVAL_MODE=auto
LOCAL_WORKER_QWEN_AUTH_TYPE=openai
LOCAL_WORKER_QWEN_OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_WORKER_QWEN_OPENAI_API_KEY=local
# Alternatively, use the full endpoint and the worker strips /chat/completions:
# AI_API_URL=http://localhost:1234/v1/chat/completions
LOCAL_WORKER_OPENCODE_BIN=opencode
LOCAL_WORKER_OPENCODE_MODEL=ollama/qwen3.5:9b
LOCAL_WORKER_OPENCODE_AGENT=local-worker

# Safety limits.
LOCAL_WORKER_MAX_CONCURRENT=1
LOCAL_WORKER_TIMEOUT_MS=1800000
LOCAL_WORKER_TEST_TIMEOUT_MS=600000
LOCAL_WORKER_ALLOW_TEST_COMMANDS=1
LOCAL_WORKER_REQUIRE_CLEAN_BASE=1
LOCAL_WORKER_DEFAULT_MAX_ITERATIONS=6
LOCAL_WORKER_MAX_ITERATIONS=12
LOCAL_WORKER_MAX_CHANGED_FILES=2
LOCAL_WORKER_MAX_RELEVANT_FILES=5
